<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title || "Not Found" %></title>

  <style>
    :root{
      --primary:#2563eb;
      --bg:#f8fafc;--card:#fff;--text:#1e293b;--muted:#64748b;--border:#e2e8f0;
      --shadow:0 4px 12px rgba(0,0,0,.06);--radius:16px;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:"DM Sans",system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
      background:var(--bg);
      color:var(--text);
      min-height:100vh;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:22px;
    }
    .card{
      width:min(820px,100%);
      background:var(--card);
      border:1px solid var(--border);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
      overflow:hidden;
    }
    .top{
      background:var(--primary);
      color:#fff;
      padding:18px 20px;
      font-weight:700;
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:12px;
      flex-wrap:wrap;
    }
    .badge{
      background:rgba(255,255,255,.2);
      border:1px solid rgba(255,255,255,.3);
      padding:6px 10px;
      border-radius:999px;
      font-size:12px;
      font-weight:700;
    }
    .content{padding:22px;}
    h1{margin:0 0 6px;font-size:26px;font-weight:700;}
    p{margin:0;color:var(--muted);line-height:1.6;}
    .actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px;}
    .btn{
      display:inline-flex;align-items:center;justify-content:center;gap:8px;
      padding:11px 14px;border-radius:10px;font-weight:600;font-size:13px;
      border:1px solid transparent;text-decoration:none;cursor:pointer;
      transition:.15s ease;
    }
    .btn-secondary{
      background:#fff;border-color:var(--border);color:var(--text);
    }
    .btn-secondary:hover{background:var(--bg)}
    .hint{
      margin-top:14px;
      font-size:12.5px;
      color:var(--muted);
      background:var(--bg);
      border:1px dashed var(--border);
      padding:12px 12px;
      border-radius:12px;
    }
    code{
      font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size:12.5px;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="top">
      <div>Samakan Core</div>
      <div class="badge">404 • Not Found</div>
    </div>

    <div class="content">
      <h1>Halaman tidak ditemukan</h1>
      <p>Link yang kamu akses tidak ada, atau sudah dipindahkan.</p>

      <div class="actions">
        <a class="btn btn-secondary" href="/auth/login">Login</a>
      </div>

      <% if (typeof path !== "undefined" && path) { %>
        <div class="hint">Requested path: <code><%= path %></code></div>
      <% } %>
    </div>
  </div>
</body>
</html>
