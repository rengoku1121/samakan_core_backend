<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <style>
    .balance-wrap { width: 100%; }
    .balance-cards {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 14px;
      margin-bottom: 18px;
    }
    .balance-card {
      padding: 16px 18px;
      border-radius: 14px;
      background: #fff;
      border: 1px solid #e7e0d8;
      box-shadow: 0 4px 12px rgba(59,41,22,0.06);
    }
    .balance-card-k {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #7a6e64;
      margin-bottom: 10px;
    }
    .balance-card-v {
      font-size: 24px;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      color: #2f2a25;
      line-height: 1.15;
    }
    .balance-card-sub {
      margin-top: 8px;
      font-size: 12px;
      color: #7a6e64;
    }

    .filter-bar {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: flex-end;
      margin-bottom: 14px;
      padding: 14px 16px;
      background: #fff;
      border: 1px solid #e7e0d8;
      border-radius: 12px;
    }
    .filter-bar .field { display:grid; gap:4px; }
    .filter-bar label { font-size:11px; font-weight:600; color:#7a6e64; text-transform:uppercase; letter-spacing:.04em; }
    .filter-bar input, .filter-bar select {
      padding: 8px 10px;
      border-radius: 8px;
      border: 1px solid #e7e0d8;
      font-size: 13px;
      font-weight: 600;
      color: #2f2a25;
      background: #fff;
      min-width: 130px;
    }
    .filter-bar input:focus, .filter-bar select:focus { border-color:#7c5cff; outline:none; box-shadow:0 0 0 3px rgba(124,92,255,0.1); }
    .filter-bar .btn-filter {
      padding: 8px 14px;
      border-radius: 8px;
      border: 0;
      background: #7c5cff;
      color: #fff;
      font-weight: 600;
      font-size: 13px;
      cursor: pointer;
    }
    .filter-bar .btn-filter:hover { background: #5d3fe2; }
    .filter-bar .btn-reset {
      padding: 8px 14px;
      border-radius: 8px;
      border: 1px solid #e7e0d8;
      background: #fff;
      color: #4f463f;
      font-weight: 600;
      font-size: 13px;
      cursor: pointer;
      text-decoration: none;
    }

    .balance-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 0;
    }
    .balance-table th {
      text-align: left;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 600;
      color: #4f463f;
      border-bottom: 1px solid #e7e0d8;
      padding: 10px 12px;
      background: #f9f5f0;
    }
    .balance-table td {
      padding: 10px 12px;
      border-bottom: 1px solid #f1ebe4;
      font-size: 13px;
      color: #2f2a25;
    }
    .balance-table tr:hover td { background: #faf6f1; }
    .mono { font-variant-numeric: tabular-nums; }
    .badge { display:inline-flex; padding:3px 8px; border-radius:999px; font-size:11px; font-weight:700; border:1px solid #e7e0d8; background:#f9f5f0; color:#4f463f; }
    .net-positive { color: #16a34a; }
    .net-negative { color: #dc2626; }

    .pager {
      display: flex;
      gap: 10px;
      justify-content: space-between;
      align-items: center;
      margin-top: 14px;
      padding: 12px 0;
      flex-wrap: wrap;
    }
    .pager-meta { color:#7a6e64; font-size:12px; }
    .pager-links { display:flex; gap:4px; align-items:center; flex-wrap:wrap; }
    .pager-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 32px;
      padding: 6px 10px;
      border-radius: 8px;
      border: 1px solid #e7e0d8;
      background: #fff;
      color: #4f463f;
      text-decoration: none;
      font-size: 12px;
      font-weight: 600;
      line-height: 1;
      transition: background .15s ease;
    }
    .pager-btn:hover { background:#f9f5f0; border-color:#d7ccbf; }
    .pager-btn.active {
      background: linear-gradient(135deg, #7c5cff, #5d3fe2);
      border-color: transparent;
      color: #fff;
      pointer-events: none;
      box-shadow: 0 4px 10px rgba(93,63,226,0.2);
    }
    .pager-btn.disabled {
      opacity: 0.4;
      pointer-events: none;
    }

    .payout-panel {
      background: #fff;
      border: 1px solid #e7e0d8;
      border-radius: 14px;
      padding: 16px 18px;
      margin-bottom: 20px;
      box-shadow: 0 4px 12px rgba(59,41,22,0.06);
    }
    .payout-panel h3 { margin: 0 0 4px; font-size: 16px; font-weight: 700; }
    .payout-hint { margin: 0 0 14px; font-size: 12px; color: #7a6e64; }
    .payout-form { display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end; }
    .payout-form .field { display: grid; gap: 4px; }
    .payout-form label { font-size: 11px; font-weight: 600; color: #7a6e64; text-transform: uppercase; letter-spacing: .04em; }
    .payout-form input, .payout-form select {
      padding: 9px 11px;
      border-radius: 8px;
      border: 1px solid #e7e0d8;
      font-size: 13px;
      font-weight: 600;
      color: #2f2a25;
      background: #fff;
      min-width: 170px;
    }
    .payout-form input:focus, .payout-form select:focus { border-color:#7c5cff; outline:none; box-shadow:0 0 0 3px rgba(124,92,255,0.1); }
    .btn-payout {
      padding: 9px 16px;
      border-radius: 8px;
      border: 0;
      background: #7c5cff;
      color: #fff;
      font-weight: 700;
      font-size: 13px;
      cursor: pointer;
    }
    .btn-payout:hover:not(:disabled) { background: #5d3fe2; }
    .btn-payout:disabled { opacity: .5; cursor: not-allowed; }
    .btn-payout-ghost {
      padding: 9px 16px;
      border-radius: 8px;
      border: 1px solid #e7e0d8;
      background: #fff;
      color: #4f463f;
      font-weight: 600;
      font-size: 13px;
      cursor: pointer;
    }
    .payout-confirm {
      margin-top: 14px;
      padding: 14px 16px;
      border-radius: 12px;
      border: 1px solid #d9cdbb;
      background: #fdf9f3;
    }
    .payout-confirm dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 16px; margin: 0 0 12px; }
    .payout-confirm dt { font-size: 12px; color: #7a6e64; }
    .payout-confirm dd { margin: 0; font-size: 13px; font-weight: 700; color: #2f2a25; font-variant-numeric: tabular-nums; }
    .payout-msg { margin-top: 12px; padding: 10px 12px; border-radius: 8px; font-size: 13px; }
    .payout-msg.ok { background: #e8f7ee; border: 1px solid #b6e3c7; color: #166534; }
    .payout-msg.err { background: #fdecec; border: 1px solid #f3bcbc; color: #991b1b; }
    .payout-msg.info { background: #eef2ff; border: 1px solid #c7d2fe; color: #3730a3; }
    .p-ok { background:#e8f7ee; border-color:#b6e3c7; color:#166534; }
    .p-bad { background:#fdecec; border-color:#f3bcbc; color:#991b1b; }
    .p-warn { background:#fff7e6; border-color:#f3ddb0; color:#92400e; }
    .p-wait { background:#eef2ff; border-color:#c7d2fe; color:#3730a3; }
    .terms-note {
      margin:14px 0 0; padding:12px 14px; font-size:13px; line-height:1.55;
      background:#f8fafc; border:1px solid #e2e8f0; border-radius:12px; color:#334155;
    }
  </style>
</head>
<body>
  <div class="balance-wrap">
    <div class="balance-cards">
      <div class="balance-card">
        <div class="balance-card-k">Saldo tersedia</div>
        <div class="balance-card-v"><%= balance.balance_fmt %></div>
        <div class="balance-card-sub">Net setelah fee</div>
      </div>
      <div class="balance-card">
        <div class="balance-card-k">Total gross</div>
        <div class="balance-card-v" style="font-size:20px;"><%= balance.total_gross_fmt %></div>
        <div class="balance-card-sub">Sebelum potongan</div>
      </div>
      <div class="balance-card">
        <div class="balance-card-k">Fee Midtrans</div>
        <div class="balance-card-v" style="font-size:20px;"><%= balance.total_midtrans_fee_fmt %></div>
        <div class="balance-card-sub">
          <%= partnership.midtrans_fee_bearer === 'merchant' ? 'Total potongan PG' : 'Ditanggung platform' %>
        </div>
      </div>
      <% if (partnership.partnership_type === 'revenue_share') { %>
      <div class="balance-card">
        <div class="balance-card-k">Bagi hasil platform</div>
        <div class="balance-card-v" style="font-size:20px;"><%= balance.total_owner_fee_fmt %></div>
        <div class="balance-card-sub"><%= partnership.revenue_share_percent %>% dari penjualan</div>
      </div>
      <% } %>
    </div>

    <p class="terms-note">
      <b>Skema kerja sama:</b> <%= partnership.summary %>.
      Saldo tersedia sudah bersih bagian Anda, jadi seluruhnya bisa ditarik.
    </p>

    <section class="payout-panel">
      <h3>Tarik Saldo (Payout)</h3>
      <% if (!payoutConfig.enabled) { %>
        <p class="payout-hint">Fitur payout belum diaktifkan. Hubungi admin untuk penarikan saldo.</p>
      <% } else { %>
        <p class="payout-hint">
          Minimum <b><%= payoutConfig.min_fmt %></b>, maksimum <b><%= payoutConfig.max_fmt %></b>.
          <% if (payoutConfig.fee_bearer === 'merchant' && payoutConfig.fee_amount > 0) { %>
            Biaya transfer <b><%= payoutConfig.fee_fmt %></b> dipotong dari saldo Anda (di luar nominal yang diterima).
          <% } else if (payoutConfig.fee_amount > 0) { %>
            Biaya transfer <b><%= payoutConfig.fee_fmt %></b> ditanggung platform.
          <% } %>
          Setelah dikonfirmasi, saldo langsung dipotong dan permintaan menunggu persetujuan admin.
        </p>

        <div class="payout-form">
          <div class="field">
            <label for="payout-bank">Bank tujuan</label>
            <select id="payout-bank"><option value="">Memuat…</option></select>
          </div>
          <div class="field">
            <label for="payout-account">Nomor rekening</label>
            <input id="payout-account" type="text" inputmode="numeric" autocomplete="off" placeholder="1234567890" />
          </div>
          <div class="field">
            <label for="payout-amount">Nominal diterima (Rp)</label>
            <input id="payout-amount" type="text" inputmode="numeric" autocomplete="off" placeholder="100000" />
          </div>
          <button id="payout-inquiry-btn" class="btn-payout" type="button">Cek Rekening</button>
        </div>

        <div id="payout-confirm" class="payout-confirm" hidden>
          <dl>
            <dt>Nama pemilik</dt><dd id="payout-c-name">-</dd>
            <dt>Rekening</dt><dd id="payout-c-account">-</dd>
            <dt>Nominal diterima</dt><dd id="payout-c-amount">-</dd>
            <dt>Biaya</dt><dd id="payout-c-fee">-</dd>
            <dt>Potongan saldo</dt><dd id="payout-c-debit">-</dd>
            <dt>Sisa saldo</dt><dd id="payout-c-after">-</dd>
          </dl>
          <button id="payout-confirm-btn" class="btn-payout" type="button">Konfirmasi Payout</button>
          <button id="payout-cancel-btn" class="btn-payout-ghost" type="button">Batal</button>
        </div>

        <div id="payout-msg" class="payout-msg" hidden></div>
      <% } %>

      <h3 style="margin-top:20px;">Riwayat Payout</h3>
      <table class="balance-table">
        <thead>
          <tr>
            <th>Ref</th>
            <th>Tujuan</th>
            <th>Diterima</th>
            <th>Potongan</th>
            <th>Status</th>
            <th>Waktu</th>
          </tr>
        </thead>
        <tbody>
          <% (payouts || []).forEach(function(p){ %>
          <tr>
            <td class="mono" style="font-size:11px;"><%= p.payout_ref %></td>
            <td>
              <%= String(p.bank_code || '').toUpperCase() %> <span class="mono"><%= p.account_number_masked %></span>
              <div style="font-size:11px; color:#7a6e64;"><%= p.account_name || '-' %></div>
            </td>
            <td class="mono"><%= p.amount_fmt %></td>
            <td class="mono"><%= p.debit_fmt %></td>
            <td><span class="badge <%= p.status_class %>"><%= p.status_label %></span></td>
            <td class="mono"><%= p.created_at_fmt %></td>
          </tr>
          <% }) %>
          <% if (!payouts || !payouts.length) { %>
          <tr><td colspan="6" style="padding:14px; color:#7a6e64;">Belum ada payout.</td></tr>
          <% } %>
        </tbody>
      </table>
    </section>

    <h3 style="margin:0 0 4px; font-size:16px; font-weight:700;">Riwayat Saldo</h3>
    <p style="margin:0 0 12px; font-size:12px; color:#7a6e64;">Total <b><%= total %></b> entri (settlement + payout).</p>

    <form method="GET" action="/merchant/balance" class="filter-bar">
      <div class="field">
        <label>Dari</label>
        <input type="date" name="date_from" value="<%= filters.date_from %>" />
      </div>
      <div class="field">
        <label>Sampai</label>
        <input type="date" name="date_to" value="<%= filters.date_to %>" />
      </div>
      <div class="field">
        <label>Limit</label>
        <select name="limit">
          <% [10,25,50,100,500].forEach(function(n){ %>
            <option value="<%= n %>" <%= limit === n ? 'selected' : '' %>><%= n %></option>
          <% }) %>
        </select>
      </div>
      <button class="btn-filter" type="submit">Filter</button>
      <a class="btn-reset" href="/merchant/balance">Reset</a>
    </form>

    <table class="balance-table">
      <thead>
        <tr>
          <th>Ref</th>
          <th>Jenis</th>
          <th>TX</th>
          <th>Gross</th>
          <th>Fee</th>
          <th>Net</th>
          <th>Waktu</th>
        </tr>
      </thead>
      <tbody>
        <% (rows || []).forEach(function(r){ %>
        <tr>
          <td class="mono" style="font-size:11px;"><%= r.settlement_ref %></td>
          <td><span class="badge"><%= r.entry_label %></span></td>
          <td class="mono"><%= r.tx_count %></td>
          <td class="mono">Rp <%= r.gross_fmt %></td>
          <td class="mono">Rp <%= r.midtrans_fee_fmt %></td>
          <td class="mono"><b class="<%= Number(r.net_amount) >= 0 ? 'net-positive' : 'net-negative' %>">Rp <%= r.net_fmt %></b></td>
          <td class="mono"><%= r.created_at_fmt %></td>
        </tr>
        <% }) %>
        <% if (!rows || !rows.length) { %>
        <tr><td colspan="7" style="padding:14px; color:#7a6e64;">Belum ada settlement.</td></tr>
        <% } %>
      </tbody>
    </table>

    <%
      const qsBase = `date_from=${encodeURIComponent(filters.date_from||'')}&date_to=${encodeURIComponent(filters.date_to||'')}&limit=${limit}`;
      const pageStart = Math.max(1, page - 2);
      const pageEnd = Math.min(totalPages, page + 2);
    %>
    <div class="pager">
      <span class="pager-meta">Halaman <b><%= page %></b> dari <b><%= totalPages %></b> &middot; <b><%= total %></b> data</span>
      <% if (totalPages > 1) { %>
        <div class="pager-links">
          <a class="pager-btn <%= page <= 1 ? 'disabled' : '' %>" href="/merchant/balance?<%= qsBase %>&page=1">First</a>
          <a class="pager-btn <%= page <= 1 ? 'disabled' : '' %>" href="/merchant/balance?<%= qsBase %>&page=<%= Math.max(1, page - 1) %>">Prev</a>
          <% for (let p = pageStart; p <= pageEnd; p++) { %>
            <a class="pager-btn <%= p === page ? 'active' : '' %>" href="/merchant/balance?<%= qsBase %>&page=<%= p %>"><%= p %></a>
          <% } %>
          <a class="pager-btn <%= page >= totalPages ? 'disabled' : '' %>" href="/merchant/balance?<%= qsBase %>&page=<%= Math.min(totalPages, page + 1) %>">Next</a>
          <a class="pager-btn <%= page >= totalPages ? 'disabled' : '' %>" href="/merchant/balance?<%= qsBase %>&page=<%= totalPages %>">Last</a>
        </div>
      <% } %>
    </div>
  </div>

  <% if (payoutConfig.enabled) { %>
  <%#
    Data lewat atribut + file /public/js/merchant-payout.js — Helmet CSP
    script-src 'self' memblokir script inline.
  #%>
  <div id="payout-meta" hidden data-csrf="<%= csrfToken %>"></div>
  <script src="/public/js/merchant-payout.js" defer></script>
  <% } %>
</body>
</html>
