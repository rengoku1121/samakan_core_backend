<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <style>
    .merchant-dash { width: 100%; }
    .merchant-dash-intro {
      margin: 0 0 20px;
      padding: 16px 18px;
      border-radius: 14px;
      background: #fff;
      border: 1px solid #e2e8f0;
    }
    .merchant-dash-intro h2 {
      margin: 0 0 6px;
      font-size: 18px;
      font-weight: 700;
      color: #1e293b;
    }
    .merchant-dash-intro p {
      margin: 0;
      font-size: 14px;
      line-height: 1.5;
      color: #64748b;
    }
    .merchant-stats {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 14px;
    }
    .merchant-stat {
      padding: 16px 18px;
      border-radius: 14px;
      background: #fff;
      border: 1px solid #e2e8f0;
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }
    .merchant-stat-k {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #64748b;
      margin-bottom: 10px;
    }
    .merchant-stat-v {
      font-size: 28px;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      color: #1e293b;
      line-height: 1.15;
    }
    .merchant-stat-sub {
      margin-top: 8px;
      font-size: 12px;
      color: #64748b;
      line-height: 1.45;
    }
    .merchant-stat-note {
      margin-top: 18px;
      padding: 12px 14px;
      font-size: 12px;
      line-height: 1.5;
      color: #64748b;
      border-radius: 12px;
      border: 1px dashed #cbd5e1;
      background: #f8fafc;
    }
  </style>
</head>
<body>
  <div class="merchant-dash">
    <section class="merchant-dash-intro">
      <h2>Selamat datang<% if (user && user.role) { %>, <%= user.role %><% } %></h2>
      <p>Ringkasan order untuk merchant Anda. Gunakan menu di kiri untuk daftar order dan generate QRIS.</p>
    </section>

    <section class="merchant-stats" aria-label="Statistik order">
      <article class="merchant-stat">
        <div class="merchant-stat-k">Total order</div>
        <div class="merchant-stat-v"><%= stats.total_orders %></div>
        <div class="merchant-stat-sub">Semua waktu</div>
      </article>
      <article class="merchant-stat">
        <div class="merchant-stat-k">Nominal menunggu bayar</div>
        <div class="merchant-stat-v" style="font-size:22px;"><%= statsFmt.pending_amount %></div>
        <div class="merchant-stat-sub"><%= stats.pending_count %> order berstatus PENDING</div>
      </article>
      <article class="merchant-stat">
        <div class="merchant-stat-k">Sukses bayar</div>
        <div class="merchant-stat-v"><%= stats.paid_flow_count %></div>
        <div class="merchant-stat-sub">Sudah terbayar (PAID / DISPENSING / DISPENSED). Sudah keluar mesin: <strong><%= stats.dispensed_count %></strong></div>
      </article>
      <article class="merchant-stat">
        <div class="merchant-stat-k">QRIS / ref pembayaran</div>
        <div class="merchant-stat-v"><%= stats.qris_recorded_count %></div>
        <div class="merchant-stat-sub">Order yang punya payment_ref atau payment_provider di database</div>
      </article>
    </section>

    <% if (balance) { %>
    <section class="merchant-stats" style="margin-top:16px;" aria-label="Saldo merchant">
      <article class="merchant-stat">
        <div class="merchant-stat-k">Saldo tersedia</div>
        <div class="merchant-stat-v" style="font-size:22px;"><%= balance.balance_fmt %></div>
        <div class="merchant-stat-sub">Total net setelah fee settlement</div>
      </article>
      <article class="merchant-stat">
        <div class="merchant-stat-k">Total gross settled</div>
        <div class="merchant-stat-v" style="font-size:18px;"><%= balance.total_gross_fmt %></div>
        <div class="merchant-stat-sub">Fee Midtrans: <%= balance.total_midtrans_fee_fmt %></div>
      </article>
    </section>
    <% } %>

    <p class="merchant-stat-note">
      Saldo dihitung dari order yang sudah di-settle oleh admin. Lihat riwayat lengkap di halaman <a href="/merchant/balance" style="color:#2563eb;">Saldo</a>.
    </p>
  </div>
</body>
</html>
