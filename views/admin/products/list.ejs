<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title %></title>
  <style>
    :root{
      --bg:#fff6ec;--card:#fff;--text:#111827;--muted:#6b7280;--border:#e5e7eb;
      --orange:#ff8a00;--orange2:#ffb866;--shadow:0 18px 45px rgba(0,0,0,.08);--radius:16px;
    }
    *{box-sizing:border-box}
    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;background:var(--bg);color:var(--text);}
    .topbar{background:linear-gradient(135deg,var(--orange),var(--orange2));color:#fff;padding:16px 22px;font-weight:900;}
    .wrap{max-width:1100px;margin:0 auto;padding:22px;}
    .header{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;margin-bottom:14px;}
    h1{margin:0;font-size:22px}
    .meta{color:var(--muted);font-size:13px;margin-top:8px}
    .actions{display:flex;gap:10px;flex-wrap:wrap;align-items:center;}
    a{color:inherit;text-decoration:none}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 12px;border-radius:12px;font-weight:900;font-size:13px;border:1px solid transparent;transition:.15s ease;}
    .btn-primary{background:linear-gradient(135deg,var(--orange),var(--orange2));color:#fff;box-shadow:0 14px 28px rgba(255,138,0,.28)}
    .btn-ghost{background:#fff;border-color:var(--border);color:#7c2d12}
    .btn-ghost:hover{background:#fff7ed}
    .btn-link{background:transparent;border-color:transparent;color:#7c2d12;padding:10px 6px}
    .btn-link:hover{text-decoration:underline}
    .card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden;}
    .toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 16px;border-bottom:1px solid #f1f5f9;background:#fff;}
    .muted{color:var(--muted);font-size:13px}
    .badge{display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border-radius:999px;font-size:12px;font-weight:900;border:1px solid var(--border);}
    .dot{width:8px;height:8px;border-radius:999px}
    .on{background:#ecfdf5;color:#065f46;border-color:#bbf7d0}.on .dot{background:#10b981}
    .off{background:#fef2f2;color:#991b1b;border-color:#fecaca}.off .dot{background:#ef4444}
    .empty{padding:26px 16px;color:var(--muted);text-align:center;}
    .product-grid{display:grid;grid-template-columns:1fr;gap:12px;padding:12px;}
    .product-card{
      display:flex;flex-direction:column;gap:12px;min-width:0;
      padding:14px;border:1px solid var(--s-border,#f4e2d9);border-radius:14px;
      background:var(--s-surface,#fff);box-shadow:var(--s-shadow-sm,0 2px 6px rgba(0,0,0,.04));
    }
    .product-head{display:flex;align-items:flex-start;gap:12px;min-width:0;}
    .product-thumb{
      width:64px;height:64px;flex:0 0 64px;border-radius:14px;object-fit:cover;
      border:1px solid var(--s-border,#f4e2d9);background:var(--s-primary-50,#fff3f1);
    }
    .product-thumb-empty{
      display:flex;align-items:center;justify-content:center;
      font-weight:800;font-size:22px;color:var(--s-primary-700,#8c171a);
    }
    .product-main{flex:1;min-width:0;}
    .product-name{margin:0;font-size:16px;font-weight:800;line-height:1.3;color:var(--s-text,#2a1a16);}
    .product-sku{margin-top:3px;font-size:12px;font-weight:700;letter-spacing:.04em;color:var(--s-muted,#8e7269);}
    .product-updated{margin:0;font-size:12px;line-height:1.35;}
    .product-price{
      margin:0;padding:10px 12px;border-radius:12px;
      background:var(--s-primary-50,#fff3f1);color:var(--s-text,#2a1a16);
      font-size:20px;font-weight:800;letter-spacing:-.02em;font-variant-numeric:tabular-nums;
    }
    .product-meta{display:grid;grid-template-columns:1fr 1fr;gap:10px 14px;margin:0;}
    .product-meta .wide{grid-column:1 / -1;}
    .product-meta dt{
      margin:0 0 2px;font-size:10.5px;font-weight:700;letter-spacing:.06em;
      text-transform:uppercase;color:var(--s-muted,#8e7269);
    }
    .product-meta dd{margin:0;font-size:13.5px;font-weight:700;line-height:1.35;overflow-wrap:anywhere;}
    .product-card > .btn{width:100%;}
    @media (min-width: 760px){
      .product-grid{grid-template-columns:1fr 1fr;}
    }
  </style>
</head>
<body>
  <div class="topbar">Samakan Admin • Products</div>

  <div class="wrap">
    <div class="header">
      <div>
        <h1>Products</h1>
        <div class="meta">Total: <b><%= total %></b> • Page <b><%= page %></b>/<b><%= totalPages %></b></div>
      </div>
      <div class="actions">
        <a class="btn btn-primary" href="/admin/products/new">+ New Product</a>
        <a class="btn btn-ghost" href="/dashboard">Dashboard</a>
        <form method="POST" action="/auth/logout">
          <button type="submit" class="btn btn-link">Logout</button>
        </form>
      </div>
    </div>

    <div class="card">
      <div class="toolbar">
        <div class="muted">Tip: price simpan integer IDR (contoh 15000)</div>
      </div>

      <% if (!rows || rows.length === 0) { %>
        <div class="empty">Belum ada product. Klik <b>New Product</b> untuk menambahkan.</div>
      <% } else { %>
        <div class="product-grid">
          <% rows.forEach(function(p){ %>
            <article class="product-card">
              <div class="product-head">
                <% if (p.image_url) { %>
                  <img class="product-thumb" src="<%= p.image_url %>" alt="" />
                <% } else { %>
                  <span class="product-thumb product-thumb-empty" aria-hidden="true"><%= (p.name || "?").trim().slice(0, 1) %></span>
                <% } %>
                <div class="product-main">
                  <h2 class="product-name"><%= p.name %></h2>
                  <div class="product-sku"><%= p.sku %></div>
                </div>
                <% if (p.is_active) { %>
                  <span class="badge on"><span class="dot"></span> Active</span>
                <% } else { %>
                  <span class="badge off"><span class="dot"></span> Inactive</span>
                <% } %>
              </div>
              <p class="product-price">Rp <%= p.price_fmt %></p>
              <dl class="product-meta">
                <div class="wide">
                  <dt>Pemilik menu</dt>
                  <dd><%= p.owner_label || "Katalog bersama" %></dd>
                </div>
                <div>
                  <dt>Shelf</dt>
                  <dd><%= p.shelf_life_label %></dd>
                </div>
                <div>
                  <dt>Panas</dt>
                  <dd><%= p.heating_label %></dd>
                </div>
              </dl>
              <p class="product-updated muted">Diperbarui <%= p.updated_at_fmt %></p>
              <a class="btn btn-ghost" href="/admin/products/<%= p.id %>/edit">Edit</a>
            </article>
          <% }) %>
        </div>
      <% } %>

      <%- include('../../partials/table-pager', { basePath: '/admin/products', page: page, limit: limit, total: total, totalPages: totalPages, shown: rows ? rows.length : 0, keepQs: '' }) %>
    </div>
  </div>
</body>
</html>
