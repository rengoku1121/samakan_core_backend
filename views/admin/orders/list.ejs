<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title %></title>
  <style>
    .stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-bottom:14px}
    .stat{padding:14px 16px}
    .stat-k{font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
    .stat-v{font-size:20px;font-weight:800;margin-top:4px;font-variant-numeric:tabular-nums}
    .stat-sub{font-size:12px;color:#8c7461;margin-top:2px}
    .settle-bar{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:10px;padding:12px 14px;margin-bottom:14px}
    .settle-bar .actions{gap:8px}
    .alert{margin:0 0 14px}
    .order-code{font-weight:800}
    .settlement-ref{margin-top:4px;font-size:12px;white-space:nowrap;max-width:220px;overflow:hidden;text-overflow:ellipsis;display:block}
    .nowrap{white-space:nowrap}
    @media (min-width:900px){.stats{grid-template-columns:repeat(4,minmax(0,1fr))}}
  </style>
</head>
<body>
  <%
    function statusClass(s) {
      if (s === "PENDING" || s === "DISPENSING") return "b-pending";
      if (s === "PAID" || s === "DISPENSED") return "b-paid";
      if (s === "FAILED" || s === "DISPENSE_FAILED" || s === "PAID_ITEM_MISSING" || s === "PAID_STOCK_FAILED") return "b-failed";
      if (s === "REFUNDED") return "b-refunded";
      return "b-other";
    }
    const prevPage = Math.max(1, page - 1);
    const nextPage = Math.min(totalPages, page + 1);
    const qsPrefix = qsBase ? qsBase + "&" : "";
  %>
  <div class="wrap">
    <div class="header">
      <div>
        <h1>Orders</h1>
        <div class="muted"><b><%= total %></b> order · <%= rangeLabel %></div>
      </div>
      <div>
        <a class="btn btn-ghost" href="/admin/orders/reconciliation">Reconciliation</a>
      </div>
    </div>

    <div class="stats">
      <div class="stat">
        <div class="stat-k">Total order</div>
        <div class="stat-v"><%= summary.total_orders %></div>
        <div class="stat-sub">Sesuai filter</div>
      </div>
      <div class="stat">
        <div class="stat-k">Order dibayar</div>
        <div class="stat-v"><%= summary.paid_orders %></div>
        <div class="stat-sub">Paid / dispense</div>
      </div>
      <div class="stat">
        <div class="stat-k">Omzet</div>
        <div class="stat-v">Rp <%= summary.sales_revenue_fmt %></div>
        <div class="stat-sub">Dari order dibayar</div>
      </div>
      <div class="stat">
        <div class="stat-k">Pending</div>
        <div class="stat-v">Rp <%= summary.pending_amount_fmt %></div>
        <div class="stat-sub">Menunggu bayar</div>
      </div>
    </div>

    <div class="card">
      <div class="toolbar">
        <form class="orders-filter" method="GET" action="/admin/orders">
          <div class="filter-q">
            <label for="f-q">Kode transaksi</label>
            <input id="f-q" type="text" name="q" value="<%= filters.q %>" placeholder="KIOSK-20261013-…" autocomplete="off" enterkeyhint="search" />
          </div>

          <div class="date-presets" aria-label="Pilih rentang cepat">
            <% presets.forEach(function(p){ %>
              <a class="chip<%= p.active ? ' is-active' : '' %>" href="/admin/orders?<%= p.qs %>"><%= p.label %></a>
            <% }) %>
          </div>

          <div>
            <label for="f-date-from">Dari tanggal</label>
            <input id="f-date-from" type="date" name="date_from" value="<%= filters.date_from %>" />
          </div>

          <div>
            <label for="f-date-to">Sampai tanggal</label>
            <input id="f-date-to" type="date" name="date_to" value="<%= filters.date_to %>" />
          </div>

          <div>
            <label for="f-status">Status</label>
            <select id="f-status" name="status">
              <option value="" <%= filters.status ? "" : "selected" %>>Semua status</option>
              <% ["PENDING","PAID","PAID_ITEM_MISSING","PAID_STOCK_FAILED","DISPENSING","DISPENSED","DISPENSE_FAILED","FAILED","EXPIRED","CANCELLED","REFUNDED"].forEach(function(s){ %>
                <option value="<%= s %>" <%= filters.status === s ? "selected" : "" %>><%= s %></option>
              <% }) %>
            </select>
          </div>

          <div>
            <label for="f-merchant">Merchant</label>
            <select id="f-merchant" name="merchant_id">
              <option value="" <%= filters.merchant_id ? "" : "selected" %>>Semua merchant</option>
              <% (merchants || []).forEach(function(m){ %>
                <option value="<%= m.id %>" <%= String(filters.merchant_id) === String(m.id) ? "selected" : "" %>>
                  <%= m.merchant_code ? m.merchant_code + " · " : "" %><%= m.name %> (#<%= m.id %>)
                </option>
              <% }) %>
            </select>
          </div>

          <div class="filter-machine">
            <label for="f-machine">Machine</label>
            <select id="f-machine" name="machine_id">
              <option value="" <%= filters.machine_id ? "" : "selected" %>>Semua mesin</option>
              <% (machines || []).forEach(function(m){ %>
                <option value="<%= m.id %>" <%= String(filters.machine_id) === String(m.id) ? "selected" : "" %>>
                  <%= m.code %> <%= m.name ? ('· ' + m.name) : '' %>
                </option>
              <% }) %>
            </select>
          </div>

          <input type="hidden" name="limit" value="<%= limit %>" />

          <button class="btn btn-primary" type="submit">Terapkan</button>
          <a class="btn btn-ghost" href="/admin/orders">Reset</a>
        </form>
      </div>

      <table>
        <thead>
          <tr>
            <th>Order</th>
            <th>Merchant</th>
            <th>Machine</th>
            <th>Status</th>
            <th>Total</th>
            <th>Dibuat</th>
            <th>Dibayar</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% (rows || []).forEach(function(r){ %>
            <tr>
              <td class="mono"><span class="order-code"><%= r.order_code %></span><div class="muted">#<%= r.id %></div></td>
              <td><b><%= r.merchant_name %></b><div class="muted mono"><%= r.merchant_code || "—" %> · ID <%= r.merchant_id %></div></td>
              <td><b><%= r.machine_code %></b><div class="muted"><%= r.machine_name || "-" %></div></td>
              <td><span class="badge <%= statusClass(r.status) %>"><%= r.status %></span></td>
              <td class="mono nowrap">Rp <b><%= r.total_fmt %></b></td>
              <td class="mono"><%= r.created_at_fmt %></td>
              <td class="mono"><%= r.paid_at_fmt %></td>
              <td><a class="btn btn-ghost btn-sm" href="/admin/orders/<%= r.id %>">Detail</a></td>
            </tr>
          <% }) %>
          <% if (!rows || rows.length === 0) { %>
            <tr><td colspan="8" class="muted" style="padding:22px;text-align:center;">Tidak ada order untuk filter ini.</td></tr>
          <% } %>
        </tbody>
      </table>

      <%- include('../../partials/table-pager', { basePath: '/admin/orders', page: page, limit: limit, total: total, totalPages: totalPages, shown: rows ? rows.length : 0, keepQs: qsBase, limits: [10, 20, 30, 50] }) %>
    </div>
  </div>
</body>
</html>
