<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title %></title>
  <style>
    :root{--bg:#fff6ec;--card:#fff;--text:#111827;--muted:#6b7280;--border:#e5e7eb;--orange:#ff8a00;--orange2:#ffb866;--shadow:0 18px 45px rgba(0,0,0,.08);--radius:16px;}
    *{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;background:var(--bg);color:var(--text);}
    .topbar{background:linear-gradient(135deg,var(--orange),var(--orange2));color:#fff;padding:16px 22px;font-weight:900;}
    .wrap{max-width:900px;margin:0 auto;padding:22px;}
    h1{margin:0 0 8px;font-size:22px}.muted{color:var(--muted);font-size:13px}
    .card{background:#fff;border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);padding:18px;margin-top:14px;}
    .btn{display:inline-flex;align-items:center;padding:10px 14px;border-radius:12px;font-weight:900;font-size:13px;border:1px solid transparent;cursor:pointer;text-decoration:none}
    .btn-primary{background:linear-gradient(135deg,var(--orange),var(--orange2));color:#fff;box-shadow:0 14px 28px rgba(255,138,0,.28)}
    .btn-ghost{background:#fff;border:1px solid var(--border);color:#7c2d12}
    .btn-danger{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}
    .row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
    .group{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:14px;margin-top:12px;}
    .group-header{font-weight:900;font-size:15px;margin-bottom:4px}
    .mono{font-variant-numeric:tabular-nums}
    textarea{width:100%;padding:10px;border:1px solid var(--border);border-radius:10px;font-size:13px;resize:vertical;min-height:60px}
    label{display:block;margin:12px 0 6px;font-weight:900;font-size:13px;color:#374151}
  </style>
</head>
<body>
  <div class="topbar">Samakan Admin • Force Settlement</div>
  <div class="wrap">
    <h1>Force Settlement</h1>
    <div class="muted">Settle semua order yang sudah <b>DISPENSED</b> dan belum settle. Fee: Midtrans <b><%= feeConfig.midtrans_fee_percent %>%</b>, Owner <b><%= feeConfig.owner_fee_percent %>%</b>.</div>

    <% if (!groups.length) { %>
    <div class="card"><div class="muted">Tidak ada order yang eligible untuk di-settle saat ini.</div></div>
    <% } else { %>

    <% groups.forEach(function(g){ %>
    <div class="group">
      <div class="group-header"><%= g.merchant_code %> • <%= g.merchant_name %></div>
      <div class="muted"><%= g.count %> order • Gross: Rp <%= g.total_fmt %></div>
    </div>
    <% }) %>

    <div class="card">
      <form method="POST" action="/admin/settlement/force">
        <input type="hidden" name="eligible_orders" value="<%= eligibleJson.replace(/"/g, '&quot;') %>" />
        <label>Catatan (opsional)</label>
        <textarea name="notes" placeholder="contoh: Force settle batch Mei 2026"></textarea>
        <div class="row">
          <button class="btn btn-danger" type="submit" onclick="return confirm('Settle semua order eligible? Tidak bisa dibatalkan.')">Settle Semua</button>
          <a class="btn btn-ghost" href="/admin/settlement">Kembali</a>
        </div>
      </form>
    </div>
    <% } %>
  </div>
</body>
</html>
