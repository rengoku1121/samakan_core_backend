<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title %></title>
  <style>
    :root{--bg:#fff6ec;--card:#fff;--text:#111827;--muted:#6b7280;--border:#e5e7eb;--orange:#ff8a00;--orange2:#ffb866;--shadow:0 18px 45px rgba(0,0,0,.08);--radius:16px;--ok-bg:#ecfdf5;--ok-border:#6ee7b7;--ok-text:#065f46;}
    *{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;background:var(--bg);color:var(--text);}
    .topbar{background:linear-gradient(135deg,var(--orange),var(--orange2));color:#fff;padding:16px 22px;font-weight:900;}
    .wrap{max-width:900px;margin:0 auto;padding:22px;}
    h1{margin:0 0 8px;font-size:22px}.muted{color:var(--muted);font-size:13px}
    .alert-ok{background:var(--ok-bg);border:1px solid var(--ok-border);color:var(--ok-text);padding:14px;border-radius:12px;margin:14px 0;font-weight:700}
    .card{background:#fff;border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden;margin-top:14px;}
    table{width:100%;border-collapse:collapse}
    thead th{text-align:left;font-size:12px;text-transform:uppercase;color:#7c2d12;background:#fff2e5;padding:10px 12px;border-bottom:1px solid #f1caa2}
    tbody td{padding:10px 12px;border-bottom:1px solid #f1f5f9;font-size:14px}
    .mono{font-variant-numeric:tabular-nums}
    .btn{display:inline-flex;align-items:center;padding:10px 14px;border-radius:12px;font-weight:900;font-size:13px;border:1px solid transparent;cursor:pointer;text-decoration:none}
    .btn-primary{background:linear-gradient(135deg,var(--orange),var(--orange2));color:#fff;box-shadow:0 14px 28px rgba(255,138,0,.28)}
    .btn-ghost{background:#fff;border:1px solid var(--border);color:#7c2d12}
    .row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
  </style>
</head>
<body>
  <div class="topbar">Samakan Admin • Settlement Berhasil</div>
  <div class="wrap">
    <h1>Settlement Berhasil</h1>
    <div class="alert-ok">Ref: <code><%= result.settlement_ref %></code></div>

    <div class="card">
      <table>
        <thead><tr><th>Merchant</th><th>Transaksi</th><th>Gross</th><th>Fee Midtrans</th><th>Fee Owner</th><th>Net (Saldo)</th></tr></thead>
        <tbody>
          <% result.merchants.forEach(function(m){ %>
          <tr>
            <td>#<%= m.merchant_id %></td>
            <td class="mono"><%= m.tx_count %></td>
            <td class="mono">Rp <%= m.gross_fmt %></td>
            <td class="mono">Rp <%= m.midtrans_fee_fmt %></td>
            <td class="mono">Rp <%= m.owner_fee_fmt %></td>
            <td class="mono"><b>Rp <%= m.net_fmt %></b></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="row">
      <a class="btn btn-primary" href="/admin/settlement">Kembali ke Dashboard Saldo</a>
      <a class="btn btn-ghost" href="/admin/settlement/ledger">Lihat Riwayat</a>
    </div>
  </div>
</body>
</html>
