<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title %></title>
  <style>
    .ledger-wrap { width: 100%; }

    .filter-bar {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: flex-end;
      margin-bottom: 14px;
      padding: 14px 16px;
      background: #fff;
      border: 1px solid #e7e0d8;
      border-radius: 12px;
    }
    .filter-bar .field { display: grid; gap: 4px; }
    .filter-bar label { font-size: 11px; font-weight: 600; color: #7a6e64; text-transform: uppercase; letter-spacing: .04em; }
    .filter-bar input, .filter-bar select {
      padding: 8px 10px;
      border-radius: 8px;
      border: 1px solid #e7e0d8;
      font-size: 13px;
      font-weight: 600;
      color: #2f2a25;
      background: #fff;
      min-width: 130px;
    }
    .filter-bar input:focus, .filter-bar select:focus { border-color: #7c5cff; outline: none; box-shadow: 0 0 0 3px rgba(124,92,255,0.1); }
    .filter-bar .btn-filter {
      padding: 8px 14px;
      border-radius: 8px;
      border: 0;
      background: #7c5cff;
      color: #fff;
      font-weight: 600;
      font-size: 13px;
      cursor: pointer;
    }
    .filter-bar .btn-filter:hover { background: #5d3fe2; }
    .filter-bar .btn-reset {
      padding: 8px 14px;
      border-radius: 8px;
      border: 1px solid #e7e0d8;
      background: #fff;
      color: #4f463f;
      font-weight: 600;
      font-size: 13px;
      cursor: pointer;
      text-decoration: none;
    }

    .ledger-table {
      width: 100%;
      border-collapse: collapse;
    }
    .ledger-table th {
      text-align: left;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 600;
      color: #4f463f;
      border-bottom: 1px solid #e7e0d8;
      padding: 10px 12px;
      background: #f9f5f0;
    }
    .ledger-table td {
      padding: 10px 12px;
      border-bottom: 1px solid #f1ebe4;
      font-size: 13px;
      color: #2f2a25;
    }
    .ledger-table tr:hover td { background: #faf6f1; }
    .mono { font-variant-numeric: tabular-nums; }
    .badge { display: inline-flex; padding: 3px 8px; border-radius: 999px; font-size: 11px; font-weight: 700; border: 1px solid #e7e0d8; background: #f9f5f0; color: #4f463f; }
    .net-positive { color: #16a34a; }
    .net-negative { color: #dc2626; }

    .pager {
      display: flex;
      gap: 10px;
      justify-content: space-between;
      align-items: center;
      margin-top: 14px;
      padding: 12px 0;
      flex-wrap: wrap;
    }
    .pager-meta { color: #7a6e64; font-size: 12px; }
    .pager-links { display: flex; gap: 4px; align-items: center; flex-wrap: wrap; }
    .pager-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 32px;
      padding: 6px 10px;
      border-radius: 8px;
      border: 1px solid #e7e0d8;
      background: #fff;
      color: #4f463f;
      text-decoration: none;
      font-size: 12px;
      font-weight: 600;
      line-height: 1;
      transition: background .15s ease;
    }
    .pager-btn:hover { background: #f9f5f0; border-color: #d7ccbf; }
    .pager-btn.active {
      background: linear-gradient(135deg, #7c5cff, #5d3fe2);
      border-color: transparent;
      color: #fff;
      pointer-events: none;
      box-shadow: 0 4px 10px rgba(93,63,226,0.2);
    }
    .pager-btn.disabled {
      opacity: 0.4;
      pointer-events: none;
    }
  </style>
</head>
<body>
  <div class="ledger-wrap">
    <h3 style="margin:0 0 4px; font-size:16px; font-weight:700;">Riwayat Settlement</h3>
    <p style="margin:0 0 12px; font-size:12px; color:#7a6e64;">Total <b><%= total %></b> entri ledger semua merchant.</p>

    <form method="GET" action="/admin/settlement/ledger" class="filter-bar">
      <% if (merchant_id) { %>
        <input type="hidden" name="merchant_id" value="<%= merchant_id %>" />
      <% } %>
      <div class="field">
        <label>Dari</label>
        <input type="date" name="date_from" value="<%= filters.date_from %>" />
      </div>
      <div class="field">
        <label>Sampai</label>
        <input type="date" name="date_to" value="<%= filters.date_to %>" />
      </div>
      <div class="field">
        <label>Limit</label>
        <select name="limit">
          <% [10,25,50,100,500].forEach(function(n){ %>
            <option value="<%= n %>" <%= limit === n ? 'selected' : '' %>><%= n %></option>
          <% }) %>
        </select>
      </div>
      <button class="btn-filter" type="submit">Filter</button>
      <a class="btn-reset" href="/admin/settlement/ledger<%= merchant_id ? '?merchant_id=' + merchant_id : '' %>">Reset</a>
    </form>

    <table class="ledger-table">
      <thead>
        <tr>
          <th>Ref</th>
          <th>Merchant</th>
          <th>Source</th>
          <th>TX</th>
          <th>Gross</th>
          <th>Fee</th>
          <th>Net</th>
          <th>Waktu</th>
        </tr>
      </thead>
      <tbody>
        <% (rows || []).forEach(function(r){ %>
        <tr>
          <td class="mono" style="font-size:11px;"><%= r.settlement_ref %></td>
          <td><b><%= r.merchant_code || "" %></b> <%= r.merchant_name %></td>
          <td><span class="badge"><%= r.source %></span></td>
          <td class="mono"><%= r.tx_count %></td>
          <td class="mono">Rp <%= r.gross_fmt %></td>
          <td class="mono">Rp <%= r.midtrans_fee_fmt %></td>
          <td class="mono"><b class="<%= Number(r.net_amount) >= 0 ? 'net-positive' : 'net-negative' %>">Rp <%= r.net_fmt %></b></td>
          <td class="mono"><%= r.created_at_fmt %></td>
        </tr>
        <% }) %>
        <% if (!rows || !rows.length) { %>
        <tr><td colspan="8" style="padding:14px; color:#7a6e64;">Belum ada riwayat.</td></tr>
        <% } %>
      </tbody>
    </table>

    <%
      const midQ = merchant_id ? `&merchant_id=${merchant_id}` : '';
      const qsBase = `date_from=${encodeURIComponent(filters.date_from||'')}&date_to=${encodeURIComponent(filters.date_to||'')}&limit=${limit}${midQ}`;
      const pageStart = Math.max(1, page - 2);
      const pageEnd = Math.min(totalPages, page + 2);
    %>
    <div class="pager">
      <span class="pager-meta">Halaman <b><%= page %></b> dari <b><%= totalPages %></b> &middot; <b><%= total %></b> data</span>
      <% if (totalPages > 1) { %>
        <div class="pager-links">
          <a class="pager-btn <%= page <= 1 ? 'disabled' : '' %>" href="/admin/settlement/ledger?<%= qsBase %>&page=1">First</a>
          <a class="pager-btn <%= page <= 1 ? 'disabled' : '' %>" href="/admin/settlement/ledger?<%= qsBase %>&page=<%= Math.max(1, page - 1) %>">Prev</a>
          <% for (let p = pageStart; p <= pageEnd; p++) { %>
            <a class="pager-btn <%= p === page ? 'active' : '' %>" href="/admin/settlement/ledger?<%= qsBase %>&page=<%= p %>"><%= p %></a>
          <% } %>
          <a class="pager-btn <%= page >= totalPages ? 'disabled' : '' %>" href="/admin/settlement/ledger?<%= qsBase %>&page=<%= Math.min(totalPages, page + 1) %>">Next</a>
          <a class="pager-btn <%= page >= totalPages ? 'disabled' : '' %>" href="/admin/settlement/ledger?<%= qsBase %>&page=<%= totalPages %>">Last</a>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>
