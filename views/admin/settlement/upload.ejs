<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title %></title>
  <style>
    :root{--bg:#fff6ec;--card:#fff;--text:#111827;--muted:#6b7280;--border:#e5e7eb;--orange:#ff8a00;--orange2:#ffb866;--shadow:0 18px 45px rgba(0,0,0,.08);--radius:16px;--danger-bg:#fef2f2;--danger-border:#fecaca;--danger-text:#991b1b;--warn-bg:#fffbeb;--warn-border:#fcd34d;--warn-text:#92400e;--ok-bg:#ecfdf5;--ok-border:#6ee7b7;--ok-text:#065f46;}
    *{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;background:var(--bg);color:var(--text);}
    .topbar{background:linear-gradient(135deg,var(--orange),var(--orange2));color:#fff;padding:16px 22px;font-weight:900;}
    .wrap{max-width:900px;margin:0 auto;padding:22px;}
    h1{margin:0 0 8px;font-size:22px}.muted{color:var(--muted);font-size:13px}
    .card{background:#fff;border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);padding:18px;margin-top:14px;}
    .alert{padding:12px;border-radius:12px;margin-bottom:12px;font-size:13px;font-weight:700;}
    .alert-danger{background:var(--danger-bg);border:1px solid var(--danger-border);color:var(--danger-text)}
    .alert-warn{background:var(--warn-bg);border:1px solid var(--warn-border);color:var(--warn-text)}
    .alert-ok{background:var(--ok-bg);border:1px solid var(--ok-border);color:var(--ok-text)}
    label{display:block;margin:12px 0 6px;font-weight:900;font-size:13px;color:#374151}
    input[type="file"]{padding:10px;border:1px solid var(--border);border-radius:12px;width:100%}
    .btn{display:inline-flex;align-items:center;padding:10px 14px;border-radius:12px;font-weight:900;font-size:13px;border:1px solid transparent;cursor:pointer;text-decoration:none}
    .btn-primary{background:linear-gradient(135deg,var(--orange),var(--orange2));color:#fff;box-shadow:0 14px 28px rgba(255,138,0,.28)}
    .btn-ghost{background:#fff;border:1px solid var(--border);color:#7c2d12}
    .row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
    table{width:100%;border-collapse:collapse;margin-top:12px}
    thead th{text-align:left;font-size:12px;text-transform:uppercase;color:#7c2d12;background:#fff2e5;padding:10px 12px;border-bottom:1px solid #f1caa2}
    tbody td{padding:10px 12px;border-bottom:1px solid #f1f5f9;font-size:13px}
    .mono{font-variant-numeric:tabular-nums}
  </style>
</head>
<body>
  <div class="topbar">Samakan Admin • Upload Settlement</div>
  <div class="wrap">
    <h1>Upload Excel Midtrans</h1>
    <div class="muted">Upload file settlement dari Midtrans. Sistem mencocokkan order_id dengan database, lalu preview sebelum konfirmasi.</div>
    <div class="muted" style="margin-top:4px;">Fee Midtrans: <b><%= feeConfig.midtrans_fee_percent %>%</b> | Fee Owner: <b><%= feeConfig.owner_fee_percent %>%</b></div>

    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <% if (!preview) { %>
    <div class="card">
      <form method="POST" action="/admin/settlement/upload/preview" enctype="multipart/form-data">
        <label>File Excel (.xlsx / .xls)</label>
        <input type="file" name="file" accept=".xlsx,.xls" required />
        <div class="muted" style="margin-top:6px;">Kolom wajib: <code>order_id</code>. Opsional: <code>midtrans_fee</code> atau <code>fee</code>.</div>
        <div class="row">
          <button class="btn btn-primary" type="submit">Preview</button>
          <a class="btn btn-ghost" href="/admin/settlement">Kembali</a>
        </div>
      </form>
    </div>
    <% } else { %>

    <div class="alert alert-ok">Matched: <b><%= preview.matched.length %></b> order DISPENSED siap settle.</div>
    <% if (preview.unmatched.length) { %><div class="alert alert-warn">Tidak ditemukan di DB: <b><%= preview.unmatched.length %></b> (<%= preview.unmatched.slice(0,5).join(", ") %><%= preview.unmatched.length > 5 ? "..." : "" %>)</div><% } %>
    <% if (preview.alreadySettled.length) { %><div class="alert alert-warn">Sudah settle sebelumnya: <b><%= preview.alreadySettled.length %></b></div><% } %>
    <% if (preview.notDispensed && preview.notDispensed.length) { %>
    <div class="alert alert-warn">
      Bukan DISPENSED (tidak di-settle): <b><%= preview.notDispensed.length %></b>
      (<%= preview.notDispensed.slice(0,5).map(function (x) { return x.id + " " + x.status; }).join(", ") %><%= preview.notDispensed.length > 5 ? "..." : "" %>)
    </div>
    <% } %>
    <% if (preview.warnings.length) { %>
    <div class="alert alert-warn">
      Fee mismatch warnings:<br/>
      <% preview.warnings.forEach(function(w){ %><div>- <%= w %></div><% }) %>
    </div>
    <% } %>

    <% if (preview.matched.length) { %>
    <div class="card">
      <table>
        <thead><tr><th>Order</th><th>Merchant</th><th>Gross</th><th>Fee Mismatch</th></tr></thead>
        <tbody>
          <% preview.matched.forEach(function(m){ %>
          <tr>
            <td class="mono"><%= m.order_code %></td>
            <td>#<%= m.merchant_id %></td>
            <td class="mono">Rp <%= new Intl.NumberFormat("id-ID").format(m.total) %></td>
            <td><%= m.hasMismatch ? "⚠️ Ya" : "OK" %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>

      <form method="POST" action="/admin/settlement/upload/confirm">
        <input type="hidden" name="matched_orders_b64" value="<%= preview.matchedB64 %>" />
        <input type="hidden" name="source" value="excel" />
        <div class="row">
          <button class="btn btn-primary" type="submit" onclick="return confirm('Settle <%= preview.matched.length %> order? Tidak bisa dibatalkan.')">Konfirmasi Settlement</button>
          <a class="btn btn-ghost" href="/admin/settlement/upload">Upload Ulang</a>
        </div>
      </form>
    </div>
    <% } else { %>
    <div class="row">
      <a class="btn btn-ghost" href="/admin/settlement/upload">Upload Ulang</a>
    </div>
    <% } %>
    <% } %>
  </div>
</body>
</html>
