<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title %></title>
  <style>
    :root{--bg:#fff6ec;--card:#fff;--text:#111827;--muted:#6b7280;--border:#e5e7eb;--orange:#ff8a00;--orange2:#ffb866;--shadow:0 18px 45px rgba(0,0,0,.08);--radius:16px;}
    *{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;background:var(--bg);color:var(--text);}
    .topbar{background:linear-gradient(135deg,var(--orange),var(--orange2));color:#fff;padding:16px 22px;font-weight:900;}
    .wrap{max-width:1200px;margin:0 auto;padding:22px;}
    h1{margin:0 0 8px;font-size:22px}.muted{color:var(--muted);font-size:13px}
    .stats{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px;margin:16px 0;}
    .stat{background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:16px;box-shadow:var(--shadow);}
    .stat-k{font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:8px}
    .stat-v{font-size:24px;font-weight:900;font-variant-numeric:tabular-nums}
    .actions{display:flex;gap:10px;flex-wrap:wrap;margin:16px 0;}
    .btn{display:inline-flex;align-items:center;padding:10px 14px;border-radius:12px;font-weight:900;font-size:13px;border:1px solid transparent;cursor:pointer;text-decoration:none}
    .btn-primary{background:linear-gradient(135deg,var(--orange),var(--orange2));color:#fff;box-shadow:0 14px 28px rgba(255,138,0,.28)}
    .btn-ghost{background:#fff;border:1px solid var(--border);color:#7c2d12}
    .card{background:#fff;border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden;margin-top:16px;}
    table{width:100%;border-collapse:collapse}
    thead th{text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:#7c2d12;background:#fff2e5;border-bottom:1px solid #f1caa2;padding:12px 14px;}
    tbody td{padding:12px 14px;border-bottom:1px solid #f1f5f9;font-size:14px;}
    tbody tr:nth-child(2n){background:#fffdf9}
    .mono{font-variant-numeric:tabular-nums}
    .alert{margin:16px 0;padding:12px 14px;border-radius:12px;font-size:13px;font-weight:700;}
    .alert-warn{background:#fff7ed;border:1px solid #fdba74;color:#9a3412}
    .alert-ok{background:#ecfdf5;border:1px solid #bbf7d0;color:#065f46}
  </style>
</head>
<body>
  <div class="topbar">Samakan Admin • Saldo Merchant</div>
  <div class="wrap">
    <h1>Saldo Merchant</h1>
    <div class="muted">Ringkasan saldo dan settlement semua merchant. Saldo = jumlah ledger, bukan flag is_settled.</div>

    <% if (resetOk) { %>
      <div class="alert alert-ok">Flag orphan di-reset: <b><%= resetCount %></b> order. Lanjut Force/Excel Settlement supaya saldo naik.</div>
    <% } %>

    <% if (orphan && orphan.orphan_count > 0) { %>
      <div class="alert alert-warn">
        <div><b><%= orphan.orphan_count %></b> order FLAG_ORPHAN (is_settled=1 tanpa settlement items) • Rp <b><%= orphanFmt %></b>.</div>
        <div class="muted" style="margin-top:6px;color:#9a3412;">Saldo belum naik. Reset flag lalu settle resmi, atau langsung Force Settlement (orphan DISPENSED ikut eligible).</div>
        <form method="POST" action="/admin/settlement/reset-orphans" style="margin-top:10px;">
          <button class="btn btn-ghost" type="submit">Reset flag orphan</button>
          <a class="btn btn-primary" href="/admin/settlement/force">Force Settlement</a>
        </form>
        <% if (orphanRows && orphanRows.length) { %>
          <div style="margin-top:10px;font-size:12px;">
            <% orphanRows.forEach(function(o){ %>
              <div class="mono">#<%= o.id %> <%= o.order_code %> · <%= o.status %> · Rp <%= Number(o.total||0).toLocaleString("id-ID") %></div>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% } %>

    <div class="stats">
      <div class="stat">
        <div class="stat-k">Total saldo semua merchant</div>
        <div class="stat-v">Rp <%= totalBalance %></div>
      </div>
      <div class="stat">
        <div class="stat-k">Belum di-settle</div>
        <div class="stat-v"><%= unsettled.unsettled_count %> order</div>
        <div class="muted">Rp <%= unsettledFmt %></div>
      </div>
      <div class="stat">
        <div class="stat-k">Flag orphan</div>
        <div class="stat-v"><%= (orphan && orphan.orphan_count) || 0 %></div>
        <div class="muted">is_settled=1 tanpa ledger</div>
      </div>
      <div class="stat">
        <div class="stat-k">Fee Midtrans</div>
        <div class="stat-v"><%= feeConfig.midtrans_fee_percent %>%</div>
      </div>
      <div class="stat">
        <div class="stat-k">Fee Owner/Platform</div>
        <div class="stat-v"><%= feeConfig.owner_fee_percent %>%</div>
      </div>
    </div>

    <div class="actions">
      <a class="btn btn-primary" href="/admin/settlement/upload">Upload Excel Midtrans</a>
      <a class="btn btn-primary" href="/admin/settlement/force">Force Settlement</a>
      <a class="btn btn-ghost" href="/admin/settlement/ledger">Riwayat Settlement</a>
    </div>

    <div class="muted" style="margin-top:12px;">Edit fee dipindahkan ke menu <b>Settings</b>.</div>

    <% if (balances && balances.length) { %>
    <div class="card">
      <table>
        <thead>
          <tr>
            <th>Merchant</th>
            <th>Saldo (Net)</th>
            <th>Gross</th>
            <th>Fee Midtrans</th>
            <th>Transaksi</th>
            <th>Last Settle</th>
          </tr>
        </thead>
        <tbody>
          <% balances.forEach(function(b){ %>
          <tr>
            <td><b><%= b.merchant_code || "" %></b> <%= b.merchant_name %></td>
            <td class="mono"><b>Rp <%= b.balance_fmt %></b></td>
            <td class="mono">Rp <%= b.total_gross_fmt %></td>
            <td class="mono">Rp <%= b.total_midtrans_fee_fmt %></td>
            <td class="mono"><%= b.total_tx %></td>
            <td class="mono"><%= b.last_settlement_at ? new Date(b.last_settlement_at).toLocaleString("id-ID") : "-" %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="muted" style="margin-top:16px;">Belum ada settlement. Upload Excel atau Force Settlement untuk memulai.</div>
    <% } %>
  </div>
</body>
</html>
