<%
  const model = String(value?.commercial_model || 'legacy');
  const cruise = model === 'cruise';
  const ownerRun = model === 'plus' || model === 'basic';
  const moneyLocked = !['admin', 'superadmin'].includes(String(user && user.role).toLowerCase());
  const lockAttr = moneyLocked ? 'disabled' : '';
  const menus = (merchants || []).filter(function (m) { return m.merchant_role === 'menu'; });
  const placePartners = (merchants || []).filter(function (m) { return m.merchant_role === 'location'; });
%>
<label for="commercial_model">Model kerja sama</label>
<select id="commercial_model" name="commercial_model" data-commercial-model <%= lockAttr %> <%= model === 'legacy' ? 'required' : '' %>>
  <% if (model === 'legacy') { %>
    <option value="" selected>Pilih paket</option>
  <% } %>
  <option value="cruise" <%= cruise ? 'selected' : '' %>>Cruise (pemilik, mitra menu, lokasi)</option>
  <option value="plus" <%= model === 'plus' ? 'selected' : '' %>>Plus (pemilik menjalankan)</option>
  <option value="basic" <%= model === 'basic' ? 'selected' : '' %>>Basic (pemilik menjalankan sendiri)</option>
</select>
<div class="hint">Cruise membagi satu penjualan. Plus dan Basic mencatat biaya bulanan dan penjualan masuk ke pemilik.</div>
<div data-package-note <%= ownerRun ? '' : 'hidden' %>>
  <div class="hint">Plus Rp 3.000.000 per bulan. Basic Rp 1.250.000 per bulan. Angka ini catatan, tidak dipotong saldo, dan tidak bisa diubah.</div>
</div>

<div data-cruise-panel <%= cruise ? '' : 'hidden' %>>
  <label for="menu_merchant_id">Mitra menu</label>
  <select id="menu_merchant_id" name="menu_merchant_id" <%= lockAttr %>>
    <option value="">-- pilih mitra menu --</option>
    <% menus.forEach(function (m) { %>
      <option value="<%= m.id %>" <%= String(value?.menu_merchant_id || '') === String(m.id) ? 'selected' : '' %>><%= m.merchant_code %> — <%= m.name %></option>
    <% }) %>
  </select>
  <div class="hint">Wajib untuk Cruise. Persennya diambil dari sisa setelah bagian pemilik.</div>

  <label for="location_merchant_id">Mitra lokasi</label>
  <select id="location_merchant_id" name="location_merchant_id" <%= lockAttr %>>
    <option value="">-- tanpa bagi hasil lokasi --</option>
    <% placePartners.forEach(function (m) { %>
      <option value="<%= m.id %>" <%= String(value?.location_merchant_id || '') === String(m.id) ? 'selected' : '' %>><%= m.merchant_code %> — <%= m.name %></option>
    <% }) %>
  </select>
  <div class="hint">Kosong berarti penempatan tanpa bagi hasil. Persennya diambil dari bagian Samakan setelah mitra menu.</div>

  <div class="grid2">
    <div>
      <label for="owner_share_percent">Bagian pemilik (%)</label>
      <input id="owner_share_percent" name="owner_share_percent" type="number" min="0.01" max="99.99" step="0.01" value="<%= value?.owner_share_percent ?? 20 %>" <%= lockAttr %> />
    </div>
    <div>
      <label for="menu_share_percent">Bagian mitra menu dari sisa (%)</label>
      <input id="menu_share_percent" name="menu_share_percent" type="number" min="0" max="100" step="0.01" value="<%= value?.menu_share_percent ?? 0 %>" <%= lockAttr %> />
    </div>
    <div>
      <label for="location_share_percent">Bagian lokasi dari sisa Samakan (%)</label>
      <input id="location_share_percent" name="location_share_percent" type="number" min="0" max="100" step="0.01" value="<%= value?.location_share_percent ?? 0 %>" <%= lockAttr %> />
    </div>
  </div>
  <div class="hint">Pemilik dihitung dari harga jual. Fee QRIS mengurangi bagian Samakan yang terakhir.</div>
</div>

<label for="merchant_id"><%= cruise || ownerRun ? 'Pemilik mesin' : 'Merchant' %></label>
<select id="merchant_id" name="merchant_id" required>
  <option value="">-- pilih <%= cruise ? 'pemilik' : 'merchant' %> --</option>
  <% (merchants || []).forEach(function (m) { %>
    <option value="<%= m.id %>" data-role="<%= m.merchant_role || 'legacy' %>" <%= String(value?.merchant_id || '') === String(m.id) ? 'selected' : '' %>><%= m.merchant_code %> — <%= m.name %></option>
  <% }) %>
</select>
<div class="hint" data-merchant-hint>
  <%= cruise ? 'Wajib. Pemilik Cruise menerima persen dari harga jual.' : (ownerRun ? 'Wajib. Pemilik Plus dan Basic menerima penjualan setelah biaya pembayaran.' : 'Wajib. Satu mesin harus ditautkan ke satu merchant.') %>
</div>
