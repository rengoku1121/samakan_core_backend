<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title %></title>
  <style>
    :root{
      --bg:#fff6ec;--card:#fff;--text:#111827;--muted:#6b7280;--border:#e5e7eb;
      --orange:#ff8a00;--orange2:#ffb866;--shadow:0 18px 45px rgba(0,0,0,.08);--radius:16px;
    }
    *{box-sizing:border-box}
    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;background:var(--bg);color:var(--text);}
    .topbar{background:linear-gradient(135deg,var(--orange),var(--orange2));color:#fff;padding:16px 22px;font-weight:900;}
    .wrap{max-width:1100px;margin:0 auto;padding:22px;}
    .header{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;margin-bottom:14px;}
    h1{margin:0;font-size:22px}
    .meta{color:var(--muted);font-size:13px;margin-top:8px}
    .actions{display:flex;gap:10px;flex-wrap:wrap;align-items:center;}
    a{color:inherit;text-decoration:none}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 12px;border-radius:12px;font-weight:900;font-size:13px;border:1px solid transparent;transition:.15s ease;}
    .btn-primary{background:linear-gradient(135deg,var(--orange),var(--orange2));color:#fff;box-shadow:0 14px 28px rgba(255,138,0,.28)}
    .btn-ghost{background:#fff;border-color:var(--border);color:#7c2d12}
    .btn-ghost:hover{background:#fff7ed}
    .btn-sm{padding:8px 10px;font-size:12px}
    .btn-link{background:transparent;border-color:transparent;color:#7c2d12;padding:10px 6px}
    .btn-link:hover{text-decoration:underline}
    .card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden;}
    .toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 16px;border-bottom:1px solid #f1f5f9;background:#fff;}
    .pill{display:inline-flex;align-items:center;gap:8px;padding:6px 10px;border-radius:999px;border:1px solid var(--border);background:#fff;color:#374151;font-weight:900;font-size:12px;}
    .pill small{color:var(--muted);font-weight:800}
    table{width:100%;border-collapse:collapse}
    thead th{position:sticky;top:0;z-index:1;text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:#7c2d12;background:#fff2e5;border-bottom:1px solid #f1caa2;padding:12px 14px;}
    tbody td{padding:10px 14px;border-bottom:1px solid #f1f5f9;font-size:14px;vertical-align:middle;line-height:1.3;}
    tbody tr:nth-child(2n){background:#fffdf9}
    tbody tr:hover{background:#fff4e6}
    .mono{font-variant-numeric:tabular-nums}
    .muted{color:var(--muted);font-size:12px}
    .badge{display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border-radius:999px;font-size:12px;font-weight:900;border:1px solid var(--border);}
    .dot{width:8px;height:8px;border-radius:999px}
    .on{background:#ecfdf5;color:#065f46;border-color:#bbf7d0}.on .dot{background:#10b981}
    .off{background:#fef2f2;color:#991b1b;border-color:#fecaca}.off .dot{background:#ef4444}
    .empty{padding:26px 16px;color:var(--muted);text-align:center;}
    .footer{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 16px;background:#fff;}
    .pager{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:flex-end;}
    .select{padding:9px 10px;border-radius:12px;border:1px solid var(--border);background:#fff;font-weight:900;font-size:13px;color:#374151;outline:none;}
    .select:focus{border-color:var(--orange);box-shadow:0 0 0 4px rgba(255,138,0,.16)}
    .act{display:flex;gap:6px;flex-wrap:nowrap;align-items:center;}
    .ell{display:inline-block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;vertical-align:bottom}
    .ell-name{max-width:110px}
    .ell-loc{max-width:150px}
    .ell-mer{max-width:140px}
    @media (min-width:901px){
      .shell .machines-table th,
      .shell .machines-table tbody td{white-space:nowrap}
      .shell .machines-table .col-act{width:1%}
    }
    @media (min-width:901px) and (max-width:1439px){
      .ell-name{display:none}
    }
    .hw-healthy{background:#ecfdf5;color:#065f46;border-color:#bbf7d0}.hw-healthy .dot{background:#10b981}
    .hw-warning{background:#fffbeb;color:#92400e;border-color:#fde68a}.hw-warning .dot{background:#f59e0b}
    .hw-critical{background:#fef2f2;color:#991b1b;border-color:#fecaca}.hw-critical .dot{background:#ef4444}
    .hw-unknown{background:#f9fafb;color:#6b7280;border-color:#e5e7eb}.hw-unknown .dot{background:#9ca3af}
    .health-filter{display:flex;flex-wrap:wrap;gap:6px}
    .hf{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-radius:999px;border:1px solid var(--border);background:#fff;font-size:12px;font-weight:800;color:#374151}
    .hf b{font-variant-numeric:tabular-nums}
    .hf.is-active{background:#fff2e5;border-color:var(--orange);color:#7c2d12}
    .hf-critical b{color:#dc2626}.hf-warning b{color:#d97706}.hf-healthy b{color:#059669}
    .machine-toast{
      margin:0 0 14px;background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0;border-radius:14px;
      padding:12px 16px;font-size:14px;font-weight:800;line-height:1.4;
      box-shadow:0 10px 24px rgba(6,95,70,.08);
    }
  </style>
</head>
<body>
  <div class="topbar">Samakan Admin • Machines</div>

  <div class="wrap">
    <div class="header">
      <div>
        <h1>Machines</h1>
        <div class="meta">Total: <b><%= total %></b> • Page <b><%= page %></b>/<b><%= totalPages %></b></div>
      </div>
      <div class="actions">
        <a class="btn btn-primary" href="/admin/machines/new">Pasang mesin</a>
        <a class="btn btn-ghost" href="/dashboard">Dashboard</a>
        <form method="POST" action="/auth/logout">
          <button type="submit" class="btn btn-link">Logout</button>
        </form>
      </div>
    </div>

    <% if (notice) { %>
      <div class="machine-toast" role="status"><%= notice %></div>
    <% } %>

    <div class="card">
      <div class="toolbar">
        <div class="health-filter" role="group" aria-label="Filter kesehatan hardware">
          <a class="hf<%= !health ? ' is-active' : '' %>" href="/admin/machines">Semua</a>
          <% ['critical', 'warning', 'healthy', 'unknown'].forEach(function (s) { %>
            <a class="hf hf-<%= s %><%= health === s ? ' is-active' : '' %>" href="/admin/machines?health=<%= s %>"><%= healthLabels[s] %> <b><%= healthSummary[s] || 0 %></b></a>
          <% }) %>
        </div>
      </div>

      <% if (!rows || rows.length === 0) { %>
        <div class="empty"><%= health ? 'Tidak ada mesin dengan status ini.' : 'Belum ada machine. Klik Pasang mesin untuk menambahkan.' %></div>
      <% } else { %>
        <table class="machines-table">
          <thead>
            <tr>
              <th>Mesin</th>
              <th>Lokasi</th>
              <th>Merchant</th>
              <th>Koneksi</th>
              <th>Hardware</th>
              <th class="col-act">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(function(m){ %>
              <%
                const pkg = { cruise: 'Cruise', plus: 'Plus', basic: 'Basic' }[m.commercial_model] || '';
                const merchantText = [m.merchant_code || '—', pkg].filter(Boolean).join(' · ');
                const merchantTitle = m.merchant_code ? (m.merchant_code + ' — ' + (m.merchant_name || '')) + (pkg ? ' · ' + pkg : '') : merchantText;
                const hbTitle = (m.last_heartbeat_at_fmt || '') + (m.last_heartbeat_app_version ? ' · APK v' + m.last_heartbeat_app_version : '');
              %>
              <tr>
                <td title="<%= m.name || '' %>"><b class="mono"><%= m.code %></b><% if (m.name && m.name !== m.code) { %> <span class="muted ell ell-name"><%= m.name %></span><% } %></td>
                <td><span class="ell ell-loc" title="<%= m.location_name || '' %>"><%= m.location_name || ('ID #' + m.location_id) %></span><% if (m.location_deleted_at) { %> <span class="muted">(arsip)</span><% } %></td>
                <td><span class="muted ell ell-mer" title="<%= merchantTitle %>"><%= merchantText %></span></td>
                <td title="<%= hbTitle %>">
                  <% if (!m.is_active) { %>
                    <span class="badge hw-unknown"><span class="dot"></span> Nonaktif</span>
                  <% } else if (m.heartbeat_online) { %>
                    <span class="badge on"><span class="dot"></span> Online</span> <span class="muted"><%= m.heartbeat_age_label %></span>
                  <% } else { %>
                    <span class="badge off"><span class="dot"></span> Offline</span> <span class="muted"><%= m.heartbeat_age_label %></span>
                  <% } %>
                </td>
                <td><span class="badge hw-<%= m.health_status %>" title="<%= m.last_health_summary || '' %>"><span class="dot"></span> <%= m.health_label %></span></td>
                <td class="act">
                  <a class="btn btn-primary btn-sm" href="/admin/machines/<%= m.id %>/detail">Detail</a>
                  <a class="btn btn-ghost btn-sm" href="/admin/machines/<%= m.id %>/edit">Edit</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>

      <%- include('../../partials/table-pager', { basePath: '/admin/machines', page: page, limit: limit, total: total, totalPages: totalPages, shown: rows ? rows.length : 0, keepQs: health ? 'health=' + health : '' }) %>
    </div>
  </div>
</body>
</html>
