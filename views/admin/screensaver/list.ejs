<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title %></title>
  <%- include('_style') %>
</head>
<body>
  <div class="wrap">
    <div class="header">
      <div>
        <h1>Iklan Screensaver</h1>
        <div class="meta">
          Iklan berbayar yang tampil di screensaver kiosk. Tayang hanya jika <b>Aktif</b>, <b>Lunas</b>, dan hari ini
          (<%= today %>, WIB) berada di periode tayang.
        </div>
      </div>
      <div class="row">
        <a class="btn btn-ghost" href="/admin/screensaver/settings">Pengaturan pemutar</a>
        <a class="btn btn-primary" href="/admin/screensaver/new">+ Campaign baru</a>
      </div>
    </div>

    <% if (notice) { %><div class="alert alert-ok"><%= notice %></div><% } %>
    <% if (errorNotice) { %><div class="alert alert-error"><b>Gagal:</b> <%= errorNotice %></div><% } %>

    <div class="card flush">
      <% if (!rows.length) { %>
        <div class="empty">Belum ada campaign. Klik <b>Campaign baru</b> untuk memasang iklan.</div>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th style="width:110px;">Preview</th>
              <th>Campaign</th>
              <th style="width:220px;">Target</th>
              <th style="width:170px;">Periode &amp; playlist</th>
              <th style="width:170px;">Biaya</th>
              <th style="width:190px;">Status</th>
              <th style="width:110px;"></th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(function (c) { %>
              <tr data-campaign-id="<%= c.id %>">
                <td>
                  <% if (c.preview && c.preview.media_type === 'video') { %>
                    <video class="thumb" src="<%= c.preview.file_path %>" muted preload="metadata"></video>
                  <% } else if (c.preview) { %>
                    <img class="thumb" src="<%= c.preview.file_path %>" alt="" loading="lazy" />
                  <% } else { %>
                    <span class="muted">Tanpa media</span>
                  <% } %>
                </td>
                <td class="stack">
                  <div><b><%= c.name %></b></div>
                  <% if (c.advertiser_name) { %><div class="muted">Pemasang: <%= c.advertiser_name %></div><% } %>
                  <div class="muted"><%= c.active_media %> media aktif dari <%= c.media.length %> · urutan <%= c.priority %></div>
                </td>
                <td class="stack">
                  <% if (!c.target_list.length) { %><span class="badge bad">Belum ada target</span><% } %>
                  <% c.target_list.forEach(function (t) { %>
                    <div class="<%= t.stale ? 'badge bad' : '' %>"><%= t.text %></div>
                  <% }) %>
                </td>
                <td class="stack">
                  <div><%= c.start_date || 'Tanpa batas awal' %> — <%= c.end_date || 'tanpa batas akhir' %></div>
                  <div class="muted"><%= playlistLabels[c.playlist_mode] %></div>
                </td>
                <td class="stack">
                  <div><b>Rp <%= c.price_fmt %></b></div>
                  <span class="badge <%= c.payment_status === 'paid' ? 'on' : c.payment_status === 'refunded' ? 'bad' : 'warn' %>"><%= paymentLabels[c.payment_status] %></span>
                  <% if (c.paid_at_fmt) { %><div class="muted">Lunas <%= c.paid_at_fmt %></div><% } %>
                  <form class="inline-form" method="POST" action="/admin/screensaver/<%= c.id %>/payment">
                    <% if (c.payment_status !== 'paid') { %>
                      <input type="hidden" name="payment_status" value="paid" />
                      <button class="btn btn-ghost btn-sm" type="submit">Tandai lunas</button>
                    <% } else { %>
                      <input type="hidden" name="payment_status" value="unpaid" />
                      <button class="btn btn-ghost btn-sm" type="submit" data-confirm="Kembalikan status ke belum bayar? Iklan akan berhenti tayang.">Batalkan lunas</button>
                    <% } %>
                  </form>
                </td>
                <td class="stack">
                  <span class="badge <%= c.live.live ? 'on' : 'off' %>"><%= c.live.text %></span>
                  <div class="muted">Status: <%= statusLabels[c.status] %></div>
                  <form class="inline-form" method="POST" action="/admin/screensaver/<%= c.id %>/status">
                    <% if (c.status === 'active') { %>
                      <input type="hidden" name="status" value="paused" />
                      <button class="btn btn-ghost btn-sm" type="submit">Jeda</button>
                    <% } else { %>
                      <input type="hidden" name="status" value="active" />
                      <button class="btn btn-ghost btn-sm" type="submit">Aktifkan</button>
                    <% } %>
                  </form>
                </td>
                <td><a class="btn btn-ghost btn-sm" href="/admin/screensaver/<%= c.id %>/edit">Edit</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
  <script src="/public/js/admin-screensaver.js" defer></script>
</body>
</html>
