<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title %></title>
  <%- include('_style') %>
</head>
<body>
  <div class="wrap">
    <div class="header">
      <div>
        <h1>Iklan Screensaver</h1>
        <div class="meta">
          Iklan berbayar yang tampil di screensaver kiosk. Tayang hanya jika <b>Aktif</b>, <b>Lunas</b>, dan hari ini
          (<%= today %>, WIB) berada di periode tayang.
        </div>
      </div>
      <div class="row">
        <a class="btn btn-ghost" href="/admin/screensaver/requests">Permintaan mitra<% if (typeof pendingRequests !== 'undefined' && pendingRequests) { %> (<%= pendingRequests %>)<% } %></a>
        <a class="btn btn-ghost" href="/admin/screensaver/sequence">Urutan tayang</a>
        <a class="btn btn-ghost" href="/admin/screensaver/house">Materi Samakan</a>
        <a class="btn btn-ghost" href="/admin/screensaver/settings">Pengaturan pemutar</a>
        <a class="btn btn-primary" href="/admin/screensaver/new">+ Campaign baru</a>
      </div>
    </div>

    <% if (notice) { %><div class="alert alert-ok"><%= notice %></div><% } %>
    <% if (errorNotice) { %><div class="alert alert-error"><b>Gagal:</b> <%= errorNotice %></div><% } %>

    <div class="card flush">
      <% if (!rows.length) { %>
        <div class="empty">Belum ada campaign. Klik <b>Campaign baru</b> untuk memasang iklan.</div>
      <% } else { %>
        <div class="ad-list">
          <% rows.forEach(function (c) { %>
            <% var slides = c.media || []; %>
            <article class="ad-row" data-campaign-id="<%= c.id %>">
              <div class="ad-preview">
                <% if (!slides.length) { %>
                  <span class="muted">Tanpa media</span>
                <% } else { %>
                  <div class="ad-slides" data-ad-slides>
                    <div class="ad-track" data-ad-track>
                      <% slides.forEach(function (m, i) { %>
                        <div class="ad-slide<%= m.status === 'active' ? '' : ' is-off' %>" data-ad-slide <%= i === 0 ? '' : 'aria-hidden="true"' %>>
                          <% if (m.media_type === 'video') { %>
                            <video src="<%= m.file_path %>" muted playsinline preload="metadata"></video>
                            <span class="ad-kind">Video</span>
                          <% } else { %>
                            <img src="<%= m.file_path %>" alt="" />
                          <% } %>
                          <% if (m.status !== 'active') { %><span class="ad-kind">Nonaktif</span><% } %>
                        </div>
                      <% }) %>
                    </div>
                    <% if (slides.length > 1) { %>
                      <button type="button" class="ad-nav ad-prev" data-ad-prev aria-label="Slide sebelumnya">‹</button>
                      <button type="button" class="ad-nav ad-next" data-ad-next aria-label="Slide berikutnya">›</button>
                      <span class="ad-count" data-ad-count>1 / <%= slides.length %></span>
                      <div class="ad-dots">
                        <% slides.forEach(function (_, i) { %>
                          <button type="button" class="ad-dot<%= i === 0 ? ' is-on' : '' %>" data-ad-dot aria-label="Slide <%= i + 1 %>"></button>
                        <% }) %>
                      </div>
                    <% } %>
                  </div>
                <% } %>
              </div>

              <div class="ad-main">
                <h2 class="ad-name"><%= c.name %></h2>
                <div class="ad-facts">
                  <% if (c.advertiser_name) { %>
                    <p class="ad-fact"><span class="ad-k">Pemasang</span><span class="ad-val"><%= c.advertiser_name %></span></p>
                  <% } %>
                  <p class="ad-fact">
                    <span class="ad-k">Target</span>
                    <% if (!c.target_list.length) { %><span class="badge bad">Belum ada target</span><% } %>
                    <% c.target_list.forEach(function (t) { %>
                      <span class="ad-val <%= t.stale ? 'badge bad' : '' %>"><%= t.text %></span>
                    <% }) %>
                  </p>
                  <p class="ad-fact ad-fact-wide">
                    <span class="ad-k">Periode</span>
                    <span class="ad-val"><%= c.start_date || 'Tanpa batas awal' %> – <%= c.end_date || 'tanpa batas akhir' %></span>
                  </p>
                  <p class="ad-fact ad-fact-wide">
                    <span class="ad-k">Putar</span>
                    <span class="ad-val"><%= playlistLabels[c.playlist_mode] %></span>
                  </p>
                </div>
                <p class="ad-note"><%= c.active_media %> media aktif dari <%= c.media.length %> · urutan <%= c.priority %></p>
              </div>

              <div class="ad-side">
                <p class="ad-price">Rp <%= c.price_fmt %></p>
                <div class="ad-badges">
                  <span class="badge <%= c.payment_status === 'paid' ? 'on' : c.payment_status === 'refunded' ? 'bad' : 'warn' %>"><%= paymentLabels[c.payment_status] %></span>
                  <span class="badge <%= c.live.live ? 'on' : 'off' %>"><%= c.live.text %></span>
                </div>
                <p class="ad-note ad-statusline">Status <%= statusLabels[c.status] %><% if (c.paid_at_fmt) { %> · Lunas <%= c.paid_at_fmt %><% } %></p>
              </div>

              <div class="ad-actions">
                <form method="POST" action="/admin/screensaver/<%= c.id %>/payment">
                  <% if (c.payment_status !== 'paid') { %>
                    <input type="hidden" name="payment_status" value="paid" />
                    <button class="btn btn-ghost" type="submit">Tandai lunas</button>
                  <% } else { %>
                    <input type="hidden" name="payment_status" value="unpaid" />
                    <button class="btn btn-ghost" type="submit" data-confirm="Kembalikan status ke belum bayar? Iklan akan berhenti tayang.">Batalkan lunas</button>
                  <% } %>
                </form>
                <form method="POST" action="/admin/screensaver/<%= c.id %>/status">
                  <% if (c.status === 'active') { %>
                    <input type="hidden" name="status" value="paused" />
                    <button class="btn btn-ghost" type="submit">Jeda</button>
                  <% } else { %>
                    <input type="hidden" name="status" value="active" />
                    <button class="btn btn-ghost" type="submit">Aktifkan</button>
                  <% } %>
                </form>
                <a class="btn btn-ghost" href="/admin/screensaver/<%= c.id %>/edit">Edit</a>
              </div>
            </article>
          <% }) %>
        </div>
        <%- include('../../partials/table-pager', { basePath: '/admin/screensaver', page: page, limit: limit, total: total, totalPages: totalPages, shown: rows.length, keepQs: '' }) %>
      <% } %>
    </div>
  </div>
  <script src="/public/js/admin-screensaver.js?v=20261014h" defer></script>
</body>
</html>
