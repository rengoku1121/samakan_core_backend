<style>
  :root{
    --bg:#fff6ec;--card:#fff;--text:#111827;--muted:#6b7280;--border:#e5e7eb;
    --orange:#ff8a00;--orange2:#ffb866;--shadow:0 18px 45px rgba(0,0,0,.08);--radius:16px;
    --danger-bg:#fef2f2;--danger-border:#fecaca;--danger-text:#991b1b;
    --ok-bg:#ecfdf5;--ok-border:#bbf7d0;--ok-text:#065f46;
  }
  *{box-sizing:border-box}
  body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;background:var(--bg);color:var(--text);}
  .wrap{max-width:1180px;margin:0 auto;padding:22px;}
  .wrap.narrow{max-width:900px}
  .header{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;margin-bottom:14px;flex-wrap:wrap}
  h1{margin:0;font-size:22px}
  h2{margin:0 0 6px;font-size:17px}
  .meta,.muted{color:var(--muted);font-size:13px}
  .card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);padding:18px;margin-bottom:16px}
  .card.flush{padding:0;overflow:hidden}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 13px;border-radius:12px;font-weight:900;font-size:13px;border:1px solid transparent;cursor:pointer;text-decoration:none;background:none;color:inherit;font-family:inherit}
  .btn-primary{background:linear-gradient(135deg,var(--orange),var(--orange2));color:#fff;box-shadow:0 14px 28px rgba(255,138,0,.28)}
  .btn-ghost{background:#fff;border-color:var(--border);color:#7c2d12}
  .btn-ghost:hover{background:#fff7ed}
  .btn-danger{background:#fff;border-color:var(--danger-border);color:var(--danger-text)}
  .btn-sm{padding:7px 10px;font-size:12px;border-radius:10px}
  .alert{padding:12px;border-radius:12px;margin-bottom:12px;font-size:13px;border:1px solid}
  .alert-error{background:var(--danger-bg);border-color:var(--danger-border);color:var(--danger-text)}
  .alert-ok{background:var(--ok-bg);border-color:var(--ok-border);color:var(--ok-text)}
  table{width:100%;border-collapse:collapse}
  thead th{text-align:left;font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:#7c2d12;background:#fff2e5;border-bottom:1px solid #f1caa2;padding:11px 12px;}
  tbody td{padding:12px;border-bottom:1px solid #f1f5f9;font-size:14px;vertical-align:top;}
  .badge{display:inline-flex;align-items:center;gap:6px;padding:4px 9px;border-radius:999px;font-size:12px;font-weight:900;border:1px solid var(--border);white-space:nowrap}
  .badge.on{background:var(--ok-bg);color:var(--ok-text);border-color:var(--ok-border)}
  .badge.off{background:#f9fafb;color:#374151}
  .badge.warn{background:#fffbeb;color:#92400e;border-color:#fde68a}
  .badge.bad{background:var(--danger-bg);color:var(--danger-text);border-color:var(--danger-border)}
  .thumb{width:96px;height:54px;object-fit:cover;border-radius:8px;border:1px solid var(--border);background:#111;display:block}
  .ad-slides{position:relative;width:100%;aspect-ratio:16/9;border-radius:12px;overflow:hidden;background:#1a100e;touch-action:pan-y}
  .ad-track{display:flex;height:100%;transition:transform .32s ease}
  .ad-slide{position:relative;flex:0 0 100%;width:100%;height:100%;min-width:0}
  .ad-slide img,.ad-slide video{width:100%;height:100%;object-fit:cover;display:block;background:#1a100e}
  .shell .ad-slide img,.shell .ad-slide video{width:100% !important;height:100% !important;max-width:none !important;object-fit:cover}
  .ad-slide.is-off img,.ad-slide.is-off video{opacity:.45}
  .ad-kind{position:absolute;left:8px;bottom:8px;padding:2px 7px;border-radius:999px;background:rgba(0,0,0,.62);color:#fff;font-size:11px;font-weight:700}
  .ad-nav{position:absolute;top:50%;transform:translateY(-50%);width:28px;height:28px;border:0;border-radius:999px;background:rgba(255,255,255,.92);color:#2a1a16;font-size:18px;line-height:1;font-weight:800;cursor:pointer;padding:0}
  .ad-prev{left:8px}
  .ad-next{right:8px}
  .ad-count{position:absolute;top:8px;right:8px;padding:2px 7px;border-radius:999px;background:rgba(0,0,0,.55);color:#fff;font-size:11px;font-weight:700}
  .ad-dots{position:absolute;left:0;right:0;bottom:8px;display:flex;justify-content:center;gap:5px}
  .ad-dot{width:7px;height:7px;padding:0;border:0;border-radius:999px;background:rgba(255,255,255,.5);cursor:pointer}
  .ad-dot.is-on{width:16px;background:#fff}
  .ad-list{display:flex;flex-direction:column;gap:12px;padding:12px}
  .ad-row{
    display:flex;align-items:center;flex-wrap:nowrap;gap:16px;
    padding:12px;border:1px solid var(--s-border,#f4e2d9);border-radius:14px;background:#fff;
  }
  .ad-preview{flex:0 0 188px;min-width:0}
  .ad-main{flex:1 1 auto;min-width:0}
  .ad-side{flex:0 0 auto;display:flex;flex-direction:column;align-items:flex-end;gap:6px;min-width:0;text-align:right}
  .ad-name{margin:0 0 6px;font-size:16px;font-weight:800;line-height:1.3;color:var(--s-text,#2a1a16)}
  .shell .ad-name{font-size:16px !important;font-weight:800 !important;line-height:1.3 !important;margin:0 0 6px !important}
  .ad-facts{display:flex;flex-wrap:wrap;gap:2px 16px}
  .ad-fact{margin:0;font-size:13px;line-height:1.35;min-width:0}
  .ad-k{margin-right:5px;font-size:10.5px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--s-muted,#8e7269)}
  .ad-note{margin:4px 0 0;font-size:12.5px;color:var(--s-muted,#8e7269);line-height:1.35}
  .ad-side .ad-note{margin:0}
  .ad-price{margin:0;font-size:18px;font-weight:800;letter-spacing:-.02em;line-height:1.2;white-space:nowrap}
  .ad-badges{display:flex;flex-wrap:wrap;gap:6px;align-items:center;justify-content:flex-end}
  .ad-actions{flex:0 0 auto;display:flex;flex-wrap:nowrap;align-items:center;gap:8px;margin:0}
  .ad-actions form{margin:0;min-width:0}
  .ad-actions .btn,.shell .ad-actions .btn{width:auto !important;min-width:0 !important;white-space:nowrap}
  @media (max-width:720px){
    .ad-row{flex-wrap:wrap;align-items:stretch;gap:12px}
    .ad-preview,.ad-main,.ad-side,.ad-actions{flex:1 1 100%}
    .ad-facts{display:grid;grid-template-columns:1fr 1fr;gap:8px 12px}
    .ad-fact-wide{grid-column:1 / -1}
    .ad-k{display:block;margin:0 0 2px}
    .ad-side{flex-direction:row;flex-wrap:wrap;align-items:center;justify-content:flex-start;text-align:left;gap:8px 10px}
    .ad-badges{justify-content:flex-start}
    .ad-statusline{flex:1 1 100%;margin:0}
    .ad-actions{display:flex;gap:8px}
    .ad-actions form,.ad-actions > .btn{flex:1 1 0;min-width:0}
    .ad-actions .btn,.shell .ad-actions .btn{width:100% !important;padding:8px 6px !important;font-size:12px !important}
    .shell .header > .row{width:100%}
    .shell .header > .row .btn{flex:1 1 0}
  }
  @media (prefers-reduced-motion:reduce){.ad-track{transition:none}}
  .stack > * + *{margin-top:6px}
  .row{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
  .inline-form{display:inline}
  .empty{padding:26px 16px;color:var(--muted);text-align:center}
  label{display:block;margin:14px 0 6px;font-weight:900;font-size:13px;color:#374151}
  input[type=text],input[type=date],input[type=number],input[type=file],select,textarea{
    width:100%;padding:11px 13px;border:1px solid var(--border);border-radius:12px;font-size:14px;background:#fff;font-family:inherit
  }
  textarea{min-height:84px;resize:vertical}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:0 16px}
  .grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:0 16px}
  @media (max-width:720px){.grid2,.grid3{grid-template-columns:1fr}}
  .hint{margin-top:6px;color:var(--muted);font-size:12.5px}
  .choices{display:flex;flex-wrap:wrap;gap:8px}
  .choice{display:flex;gap:8px;align-items:center;margin:0;font-weight:700;padding:9px 12px;border:1px solid var(--border);border-radius:12px;background:#fff;cursor:pointer}
  .choice input{margin:0}
  .pick-list{max-height:260px;overflow:auto;border:1px solid var(--border);border-radius:12px;padding:6px;background:#fff}
  .pick-list .choice{border:0;padding:6px 8px}
  [hidden]{display:none !important}
  .media-row{display:grid;grid-template-columns:120px 1fr auto;gap:14px;align-items:center;padding:12px 0;border-top:1px solid #f1f5f9}
  .media-row:first-child{border-top:0}
  .media-row .thumb{width:120px;height:68px}
  .media-actions{display:flex;flex-wrap:wrap;gap:6px;align-items:center;justify-content:flex-end}
  .media-actions input[type=number]{width:76px;padding:7px 8px}
  .media-actions select{width:auto;padding:7px 8px}
  @media (max-width:720px){.media-row{grid-template-columns:1fr}.media-actions{justify-content:flex-start}}
  .section-title{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
  .slide-list{border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-top:12px}
  .slide-row{display:grid;grid-template-columns:110px 1fr 140px;gap:12px;align-items:center;padding:12px;border-top:1px solid #f1f5f9}
  .slide-row:first-child{border-top:0}
  .slide-row label{margin:0 0 6px}
  .slide-on{margin:0;font-weight:700}
  .file-seconds{list-style:none;padding:0;margin:10px 0 0}
  .file-seconds li{display:grid;grid-template-columns:1fr 110px;gap:10px;align-items:center;padding:8px 0;border-top:1px solid #f1f5f9}
  .file-seconds li:first-child{border-top:0}
  .file-seconds input{margin:0}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0}
  @media (max-width:720px){.slide-row,.file-seconds li{grid-template-columns:1fr}}
</style>
