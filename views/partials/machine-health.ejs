<%#
  Kartu Kesehatan Hardware. Locals:
  - health: hasil buildMachineHealth()
  - intervalAction: URL POST override interval; kosong = baca-saja (teknisi)
  - healthNotice / healthError: pesan setelah simpan
%>
<%
  const h = health;
  const canEdit = typeof intervalAction !== "undefined" && intervalAction;
  const hNotice = typeof healthNotice !== "undefined" ? healthNotice : null;
  const hError = typeof healthError !== "undefined" ? healthError : null;
  const globalMin = h.globalIntervalMs ? Math.round(h.globalIntervalMs / 60000) : null;
  const ownMin = h.intervalMs ? Math.round(h.intervalMs / 60000) : null;
%>
<style>
  .mh-card{background:#fff;border:1px solid #e5e7eb;border-radius:16px;box-shadow:0 18px 45px rgba(0,0,0,.08);padding:20px;margin-top:18px}
  .mh-card h2{margin:0 0 4px;font-size:17px}
  .mh-muted{color:#64748b;font-size:13px}
  .mh-head{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;margin-bottom:6px}
  .mh-badge{display:inline-flex;align-items:center;padding:5px 10px;border-radius:999px;font-size:12px;font-weight:900;border:1px solid #e5e7eb}
  .mh-badge::before{content:"";width:8px;height:8px;border-radius:999px;margin-right:6px;background:currentColor}
  .mh-healthy{background:#ecfdf5;color:#065f46;border-color:#bbf7d0}
  .mh-warning{background:#fffbeb;color:#92400e;border-color:#fde68a}
  .mh-critical{background:#fef2f2;color:#991b1b;border-color:#fecaca}
  .mh-unknown{background:#f9fafb;color:#6b7280;border-color:#e5e7eb}
  .mh-sim{background:#eef2ff;color:#3730a3;border-color:#c7d2fe;margin-right:6px}
  .mh-sim-note{margin-top:12px;padding:10px 12px;border-radius:12px;background:#eef2ff;border:1px solid #c7d2fe;color:#3730a3;font-size:13px;line-height:1.45}
  .mh-tag{display:inline-block;margin-left:6px;padding:1px 7px;border-radius:999px;background:#eef2ff;color:#3730a3;font-size:11px;font-weight:800}
  .mh-summary{margin:12px 0 0;padding:12px 14px;background:#fffdf9;border:1px solid #f1e7dc;border-radius:12px;font-size:14px;line-height:1.45}
  .mh-section{margin:18px 0 6px;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.06em;color:#7c2d12}
  .mh-list{list-style:none;margin:0;padding:0}
  .mh-list li{padding:7px 0;border-bottom:1px solid #f1f5f9;font-size:13px;line-height:1.4}
  .mh-ok{color:#059669;font-weight:900;margin-right:6px}
  .mh-fail{color:#dc2626;font-weight:900;margin-right:6px}
  .mh-table{width:100%;border-collapse:collapse;font-size:13px}
  .mh-table th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:#7c2d12;background:#fff2e5;padding:9px 10px}
  .mh-table td{padding:8px 10px;border-bottom:1px solid #f1f5f9;vertical-align:middle}
  .mh-pager{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;margin-top:10px}
  .mh-pager a{display:inline-block;padding:7px 10px;margin-left:6px;border:1px solid #e5e7eb;border-radius:10px;font-size:12px;font-weight:800;color:#7c2d12;text-decoration:none}
  .mh-form{margin-top:10px}
  .mh-form input{width:100%;max-width:220px;padding:10px 12px;border:1px solid #e5e7eb;border-radius:12px;font-size:14px}
  .mh-form button{margin-top:10px;padding:10px 14px;border:0;border-radius:12px;font-weight:900;font-size:13px;color:#fff;cursor:pointer;background:linear-gradient(135deg,#ff8a00,#ffb866)}
  .mh-alert-ok{margin-top:12px;padding:10px 12px;border-radius:12px;background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46;font-size:13px}
  .mh-alert-err{margin-top:12px;padding:10px 12px;border-radius:12px;background:#fef2f2;border:1px solid #fecaca;color:#991b1b;font-size:13px}
  .mh-groups{display:grid;grid-template-columns:repeat(auto-fit,minmax(420px,1fr));gap:14px}
  .mh-group{border:1px solid #f1e7dc;border-radius:14px;overflow:hidden;background:#fff}
  .mh-group-head{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 12px;background:#fffaf5;border-bottom:1px solid #f1e7dc;font-size:13px;font-weight:900;color:#334155}
  .mh-group-count{font-size:11px;font-weight:800;color:#065f46;white-space:nowrap}
  .mh-group-bad{color:#991b1b}
  .mh-scroll{overflow-x:auto}
  .mh-diag-table{width:100%;border-collapse:collapse;font-size:13px}
  .mh-diag-table th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:#64748b;background:#f8fafc;padding:8px 12px;white-space:nowrap}
  .mh-diag-table td{padding:8px 12px;border-top:1px solid #f1f5f9;vertical-align:top;line-height:1.45;color:#334155}
  .mh-diag-table td small{display:block;margin-top:2px;color:#94a3b8;font-size:11px}
  .mh-diag-table code{font-size:11px;color:#475569;background:#f1f5f9;border-radius:6px;padding:1px 6px;white-space:nowrap}
  .mh-col-check{width:38%}
  .mh-col-code{width:1%;white-space:nowrap}
  .mh-col-status{width:1%;text-align:center;white-space:nowrap}
  .mh-row-bad td{background:#fef2f2}
  .mh-pill{display:inline-block;padding:2px 9px;border-radius:999px;font-size:11px;font-weight:900}
  .mh-pill-ok{background:#ecfdf5;color:#065f46}
  .mh-pill-bad{background:#fee2e2;color:#991b1b}
  .mh-kv{border-collapse:collapse;width:100%}
  .mh-diag-table .mh-kv td{border:0;padding:2px 0;vertical-align:baseline}
  .mh-diag-table .mh-kv td:first-child{color:#64748b;padding-right:12px}
  .mh-diag-table .mh-kv td:last-child{font-weight:800;text-align:right;white-space:nowrap}
  .mh-link{display:inline-block;margin-left:6px;font-size:12px;font-weight:800;color:#c2410c;text-decoration:none}
  .mh-val{font-weight:800;white-space:nowrap}
  .mh-val-ok{color:#065f46}
  .mh-val-warn{color:#92400e}
  .mh-glossary{margin-top:10px;font-size:13px}
  .mh-glossary > summary{cursor:pointer;font-weight:800;color:#7c2d12;margin-bottom:8px}
  .mh-glossary .mh-scroll{border:1px solid #f1e7dc;border-radius:14px}
  @media (max-width:640px){
    .mh-groups{grid-template-columns:1fr}
    .mh-col-check{width:auto}
  }
</style>

<div class="mh-card" id="kesehatan">
  <div class="mh-head">
    <h2>Kesehatan hardware</h2>
    <span>
      <% if (h.simulated) { %><span class="mh-badge mh-sim">Data simulasi</span><% } %>
      <span class="mh-badge mh-<%= h.status %>"><%= h.statusLabel %></span>
    </span>
  </div>
  <div class="mh-muted">Laporan terakhir dari kiosk: <b><%= h.lastAt %></b></div>
  <% if (h.simulated) { %>
    <div class="mh-sim-note">Laporan ini dari simulator VMC (kiosk dijalankan di browser), bukan dari mesin asli. Abaikan untuk keputusan perawatan.</div>
  <% } %>

  <% if (hNotice) { %><div class="mh-alert-ok"><%= hNotice %></div><% } %>
  <% if (hError) { %><div class="mh-alert-err"><%= hError %></div><% } %>

  <div class="mh-summary">
    <% if (h.uartDown) { %><b>Kiosk tidak tersambung ke VMC (UART).</b> <% } %>
    <%= h.summary || (h.status === "unknown" ? "Kiosk belum mengirim laporan hardware." : "Semua normal") %>
  </div>
  <% if (h.linkLine) { %><p class="mh-muted"><%= h.linkLine %></p><% } %>

  <% if (h.diagnosticGroups.length) { %>
    <p class="mh-section">Diagnostik terakhir</p>
    <div class="mh-groups">
      <% h.diagnosticGroups.forEach(function (g) { %>
        <div class="mh-group">
          <div class="mh-group-head">
            <span><%= g.title %></span>
            <span class="mh-group-count<%= g.failed ? ' mh-group-bad' : '' %>">
              <%= g.failed ? g.failed + ' gagal' : 'Semua OK' %> · <%= g.rows.length %> cek
            </span>
          </div>
          <div class="mh-scroll">
            <table class="mh-diag-table">
              <thead><tr><th class="mh-col-check">Pemeriksaan</th><th>Hasil</th><th class="mh-col-status">Status</th></tr></thead>
              <tbody>
                <% g.rows.forEach(function (d) { %>
                  <tr class="<%= d.ok ? '' : 'mh-row-bad' %>">
                    <td class="mh-col-check"><b><%= d.label %></b></td>
                    <td>
                      <% if (d.parts.length) { %>
                        <table class="mh-kv">
                          <% d.parts.forEach(function (p) { %>
                            <tr><td><%= p.label %></td><td><%= p.value %></td></tr>
                          <% }) %>
                        </table>
                      <% } else { %>
                        <%= d.note || '—' %>
                        <% if (d.sensors.length) { %><a class="mh-link" href="#mh-sensor">Lihat tabel sensor ↓</a><% } %>
                      <% } %>
                    </td>
                    <td class="mh-col-status">
                      <span class="mh-pill <%= d.ok ? 'mh-pill-ok' : 'mh-pill-bad' %>"><%= d.ok ? 'OK' : 'Gagal' %></span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% }) %>
    </div>

    <% if (h.sensors.length) { %>
      <p class="mh-section" id="mh-sensor">Sensor lunch box</p>
      <div class="mh-group">
        <div class="mh-scroll">
          <table class="mh-diag-table">
            <thead><tr><th class="mh-col-check">Sensor</th><th class="mh-col-code">Kode</th><th>Kondisi</th></tr></thead>
            <tbody>
              <% h.sensors.forEach(function (s) { %>
                <tr>
                  <td class="mh-col-check"><%= s.name %></td>
                  <td class="mh-col-code"><% if (s.known) { %><code><%= s.code %></code><% } else { %>—<% } %></td>
                  <td><span class="mh-val<%= s.tone === 'ok' ? ' mh-val-ok' : s.tone === 'warn' ? ' mh-val-warn' : '' %>"><%= s.value || '—' %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <details class="mh-glossary">
        <summary>Arti singkatan sensor</summary>
        <div class="mh-scroll">
          <table class="mh-diag-table">
            <thead><tr><th class="mh-col-code">Kode</th><th class="mh-col-check">Nama</th><th>Penjelasan</th></tr></thead>
            <tbody>
              <% h.sensorGlossary.forEach(function (g) { %>
                <tr>
                  <td class="mh-col-code"><code><%= g.code %></code></td>
                  <td class="mh-col-check"><b><%= g.name %></b></td>
                  <td><%= g.meaning %><% if (g.origin) { %><small><%= g.origin %></small><% } %></td>
                </tr>
              <% }) %>
              <tr>
                <td class="mh-col-code"><code>ON / OFF</code></td>
                <td class="mh-col-check"><b>Nilai sakelar</b></td>
                <td>1 = sakelar ON, 0 = sakelar OFF. Pintu "Tertutup" berarti sakelar tutup ON dan sakelar buka OFF.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </details>
    <% } %>
  <% } %>

  <% if (h.driveErrors.length) { %>
    <p class="mh-section">Dispense gagal sejak laporan sebelumnya</p>
    <ul class="mh-list">
      <% h.driveErrors.forEach(function (e) { %>
        <li><span class="mh-fail">✗</span><%= e.label %> <span class="mh-muted">· <%= e.at %></span></li>
      <% }) %>
    </ul>
  <% } %>

  <p class="mh-section">Riwayat laporan</p>
  <% if (!h.history.rows.length) { %>
    <div class="mh-muted">Belum ada riwayat.</div>
  <% } else { %>
    <table class="mh-table">
      <thead><tr><th>Status</th><th>Sejak</th><th>Terakhir</th><th>Laporan</th><th>Keterangan</th><th>Sumber</th></tr></thead>
      <tbody>
        <% h.history.rows.forEach(function (r) { %>
          <tr>
            <td><span class="mh-badge mh-<%= r.status %>"><%= h.statusLabels[r.status] || r.status %></span></td>
            <td><%= r.since %></td>
            <td><%= r.last %></td>
            <td><%= r.count %></td>
            <td><%= r.summary || "—" %></td>
            <td><%= r.source %><% if (r.simulated) { %><span class="mh-tag">simulasi</span><% } %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% if (h.history.totalPages > 1) { %>
      <div class="mh-pager">
        <span class="mh-muted">Hal. <%= h.history.page %>/<%= h.history.totalPages %> · <%= h.history.total %> periode</span>
        <span>
          <% if (h.history.page > 1) { %><a href="<%= h.history.basePath %>?hpage=<%= h.history.page - 1 %>#kesehatan">‹ Lebih baru</a><% } %>
          <% if (h.history.page < h.history.totalPages) { %><a href="<%= h.history.basePath %>?hpage=<%= h.history.page + 1 %>#kesehatan">Lebih lama ›</a><% } %>
        </span>
      </div>
    <% } %>
  <% } %>

  <p class="mh-section">Interval laporan</p>
  <div class="mh-muted">
    Sekarang: <b><%= ownMin ? ownMin + " menit (khusus mesin ini)" : (globalMin ? globalMin + " menit (ikut Settings)" : "ikut Settings") %></b>
  </div>
  <% if (canEdit) { %>
    <form class="mh-form" method="POST" action="<%= intervalAction %>">
      <label for="health_interval" class="mh-muted">Override interval (menit, 5–1440)</label><br />
      <input id="health_interval" name="health_report_interval_min" type="number" step="1" min="5" max="1440"
        value="<%= ownMin || '' %>" placeholder="Kosongkan = ikut Settings" />
      <br /><button type="submit">Simpan interval</button>
    </form>
  <% } %>
</div>
