# Copy to .env and fill real values. Never commit .env.

PORT=4000
NODE_ENV=production

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=saporsi_core

# Use a long random string (32+ chars). App refuses weak secrets in production.
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_ISSUER=samakan-core
COOKIE_SECRET=

# 0 = allow cookie on http://localhost (local dev). Production HTTPS: set 1 or omit.
COOKIE_SECURE=0

# Set 1 hanya di production HTTPS. Jangan aktifkan di LAN http://192.168.x.x
# (Helmet default upgrade-insecure-requests memblokir submit login).
# CSP_UPGRADE_INSECURE=1

VENDOR_PAYMENT_BASE_URL=http://localhost:5000
# Shared with vendor/.env — required or Midtrans webhook returns 503.
# Vendor juga menolak /api/payments/* tanpa token ini.
VENDOR_PAYMENT_INTERNAL_TOKEN=
# Shared with kiosk environment.kioskToken (atau isian di Mode Servis kiosk)
KIOSK_API_INTERNAL_TOKEN=
# VENDOR_PAYMENT_TIMEOUT_MS=15000

# Kode mesin kiosk default untuk npm run report:planogram
KIOSK_MACHINE_CODE=MER-000001-M1

# Denah fisik mesin (validasi slot_code + katalog kiosk). Default 8 x 4.
# VMC_SLOT_ROWS=8
# VMC_SLOT_COLS=4

# 1 = izinkan QR preview lokal saat vendor/Midtrans down. Otomatis mati saat
# NODE_ENV=production. JANGAN diaktifkan di mesin yang menerima uang.
# ALLOW_DEMO_QR_FALLBACK=0

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# XY Vending Machine Platform (API.pdf) — isi saat credential dari XY siap
# Base tanpa trailing slash, contoh: http://175.6.71.238:8090/service-api
XY_API_BASE_URL=
XY_API_KEY=
XY_API_SECRET=
# Merchant ID di portal XY (parameter shbh)
XY_MERCHANT_ID=
# Timeout HTTP ke XY (ms), default 20000
# XY_API_TIMEOUT_MS=20000
